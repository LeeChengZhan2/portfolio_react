---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/Hero.astro';
import Carousel from '../components/react/Carousel';
import type { CarouselItem } from '../components/react/Carousel';
import { getSections, getFeaturedWork, formatYears } from '../lib/content';

const sections = await getSections();

// Island props are serialised into the HTML, so send the four fields the
// carousel renders rather than the whole collection entry.
const featured: CarouselItem[] = (await getFeaturedWork()).map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  summary: entry.data.summary,
  year: formatYears(entry.data),
  stack: entry.data.stack,
  current: entry.data.current,
}));
---

<BaseLayout
  isHome
  title="Lee Cheng Zhan"
  description="Software engineer in Singapore building production AI agents and the data platforms behind them. Mathematics with Computing graduate, ex-Java developer in banking."
>
  <Hero />

  <section class="section" id="about">
    <div class="wrap">
      <p class="eyebrow" data-reveal="fade">About</p>
      <h2 class="section-title" data-reveal="split-lines">
        Software engineer building production AI agents and the data platforms behind them.
      </h2>

      <div class="prose" data-reveal="fade-up">
        <p>
          I'm a software engineer in Singapore, working on building automation. I
          design and ship the multi-agent AI systems that let an operator ask a
          building a question in plain English, and the cloud data platform
          underneath them that makes an answer possible at all.
        </p>
        <p>
          I started out in fintech in Kuala Lumpur, writing Java for bank clients.
          Three years on I tend to own what I build end to end — development,
          deployment, CI/CD — solo or in a small team. Behind it is a degree in
          Mathematics with Computing from Tunku Abdul Rahman University of
          Management and Technology, an unusual pairing of a mathematics major
          with a computer science minor.
        </p>
      </div>

      <a href="/about" class="link-button" data-reveal="fade-up" data-reveal-delay="0.1">
        More about me
      </a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section section--alt" id="work">
        <div class="wrap">
          <p class="eyebrow" data-reveal="fade">Selected work</p>
          <h2 class="section-title" data-reveal="fade-up">What I've been building</h2>

          {/* The site's only React island. `client:visible` holds its JS back
              until the section is scrolled to, and it lives on this leaf page
              alone so the React runtime is never paid for on the other nine. */}
          <div class="w-full" data-reveal="fade-up">
            <Carousel client:visible items={featured} label="Featured work" />
          </div>

          <a href="/work" class="link-button" data-reveal="fade-up">See all work</a>
        </div>
      </section>
    )
  }

  <section class="section" id="explore">
    <div class="wrap">
      <p class="eyebrow" data-reveal="fade">Elsewhere</p>
      <h2 class="section-title" data-reveal="fade-up">Beyond the day job</h2>

      <ul class="card-grid card-grid--tight">
        {
          sections.map((section, i) => (
            <li data-reveal="fade-up" data-reveal-delay={String(i * 0.08)}>
              <a href={`/about/${section.id}`} class="card">
                <h3 class="card__title">{section.data.title}</h3>
                <p class="card__summary">{section.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "#styles";

  .section {
    @apply px-6 py-24 lg:px-12 lg:py-32;
  }

  /* Was `bg-white`, identical to the body background — so the "alt" band did
     nothing at all. `band` gives it the tonal step it was always meant to have,
     stepping away from the page in whichever direction the theme calls for. */
  .section--alt {
    @apply bg-band;
  }

  .wrap {
    @apply mx-auto flex max-w-5xl flex-col items-start gap-6;
  }

  .eyebrow {
    @apply font-mono text-xs uppercase tracking-[0.16em] text-fg-meta;
  }

  .section-title {
    @apply max-w-3xl text-3xl font-bold tracking-tight lg:text-4xl;
    text-wrap: balance;
  }

  .prose {
    @apply flex max-w-2xl flex-col gap-4 text-fg-body;
  }

  .link-button {
    @apply mt-2 inline-block rounded-lg bg-invert px-6 py-3 text-sm font-semibold text-on-invert transition-colors hover:bg-accent;
  }

  .card-grid {
    @apply mt-4 grid w-full gap-5 sm:grid-cols-2 lg:grid-cols-3;
  }

  .card-grid--tight {
    @apply lg:grid-cols-4;
  }

  .card {
    @apply flex h-full flex-col gap-2 rounded-2xl border border-line bg-surface p-6 transition-all duration-300;
    @apply hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg;
  }

  .card__title {
    @apply text-lg font-semibold text-fg;
  }

  .card__summary {
    @apply text-sm leading-relaxed text-fg-muted;
  }
</style>
