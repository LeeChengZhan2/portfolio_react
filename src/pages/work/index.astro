---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/astro/WorkRow.astro';
import { getWork } from '../../lib/content';

const work = await getWork();

/**
 * Grouping replaced the per-row "Current" badge, which was too quiet to notice.
 * A reader can skim past a small pill; a heading they have to read past is the
 * point. Row order inside each group is untouched — `order` still drives it.
 *
 * Empty groups drop out, so removing the last `current: true` entry leaves a
 * plain list rather than a heading with nothing under it.
 */
const groups = [
  { id: 'current', title: 'Currently building', entries: work.filter((e) => e.data.current) },
  { id: 'past', title: 'Previously', entries: work.filter((e) => !e.data.current) },
].filter((group) => group.entries.length > 0);
---

<BaseLayout
  title="Work"
  description="Projects and engineering work — AI agents for building operations, the data platform behind them, Java banking applications, and a game-theory final year project."
>
  <article class="page">
    <header class="page__header">
      <p class="eyebrow" data-reveal="fade">Work</p>
      <h1 class="page__title" data-reveal="split-lines">Projects and engineering</h1>
    </header>

    {
      groups.map((group) => (
        <section class="group">
          <h2
            class:list={['group__title', { 'group__title--current': group.id === 'current' }]}
            data-reveal="fade"
          >
            {group.title}
          </h2>

          <ul class="list">
            {group.entries.map((entry, i) => (
              <li data-reveal="fade-up" data-reveal-delay={String(i * 0.07)}>
                <WorkRow entry={entry} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  @reference "#styles";

  .page {
    @apply mx-auto max-w-4xl px-6 py-20 lg:py-28;
  }

  .page__header {
    @apply mb-12 flex flex-col gap-3;
  }

  .eyebrow {
    @apply font-mono text-xs uppercase tracking-[0.16em] text-fg-meta;
  }

  .page__title {
    @apply text-4xl font-bold tracking-tight lg:text-5xl;
  }

  .group {
    @apply mb-14 last:mb-0;
  }

  .group__title {
    @apply mb-1 font-mono text-xs uppercase tracking-[0.16em] text-fg-meta;
  }

  /* The only accent on the page, so the live work is what the eye lands on. */
  .group__title--current {
    @apply text-accent;
  }

  .list {
    @apply flex flex-col;
  }

  /* Closes the last row of each group. Lives on the <li>, not on `.row`: the row
     is a separate component with its own style scope, so a descendant selector
     from here would not match it. */
  .list li:last-child {
    @apply border-b border-line;
  }
</style>
