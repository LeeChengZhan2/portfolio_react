---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TravelContent from '../../components/astro/TravelContent.astro';
import trails from '../../data/trails.json';
import MapGlobeStage from '../../components/astro/MapGlobeStage.astro';
import MapShowcase, { type ShowcaseTrip } from '../../components/astro/MapShowcase.astro';
import type { MapTrip } from '../../scripts/mapglobe/engine';
import {
  formatTripDates,
  getSections,
  getTrips,
  tripPhotos,
  tripYear,
  walkedOn as walkedOnTrips,
} from '../../lib/content';

/**
 * /about/travel with the MapLibre earth under the timeline, so it can be judged
 * in the real page instead of from screenshots.
 *
 * It used to hold two more sections: a three.js earth in six looks, and a
 * mock-up of three ways to navigate the map. Both were removed on 24 Nov 2026
 * at the author's call — MapLibre is the earth that stays.
 *
 * Throwaway, like /theme-preview: noindex, out of the sitemap, and reachable
 * only from a small link on /about/travel. When the earth is ready, move
 * MapGlobeStage onto the real page and delete this file and the link.
 *
 * The body is the same TravelContent the real page renders, so "all the travel
 * information" here cannot fall behind what /about/travel says.
 */
const entry = await getEntry('sections', 'travel');
if (!entry) throw new Error('src/content/sections/travel.md is missing — this page renders its prose.');
const { Content } = await render(entry);

const trips = await getTrips();

let previousYear: string | null | undefined;
const rows = trips.map((trip) => {
  const year = tripYear(trip.data);
  const yearLabel = year === previousYear ? undefined : (year ?? 'Undated');
  previousYear = year;
  return { trip, yearLabel };
});

const places = new Set(trips.map((trip) => trip.data.country ?? trip.data.title));

const sections = await getSections();
const index = sections.findIndex((section) => section.id === entry.id);
const prev = sections[index - 1];
const next = sections[index + 1];

/**
 * What the map needs about each trip: a label, a date and somewhere to go.
 * Positions are not here — they come from the built-up footprint in
 * public/globe/visited.json, keyed by the same id, so a marker can never sit
 * somewhere the highlighted area is not.
 *
 * The date is deliberately just the year. On the timeline "14–18 Nov 2025" is
 * the fact; on a label 90 pixels wide it is noise, and the year is what places
 * a trip in the sequence. Undated trips say so rather than showing nothing —
 * tripYear returns null below year precision.
 */
const mapTrips: MapTrip[] = trips.map((trip) => ({
  id: trip.id,
  label: trip.data.title.split(',')[0]!.trim(),
  when: tripYear(trip.data) ?? 'Undated',
  href: `/about/travel/${trip.id}`,
}));

/**
 * Which recorded routes were walked on which trip, from the dates alone.
 *
 * Derived here rather than inside MapGlobeStage because this is the page that
 * has the trip entries: `MapTrip` deliberately carries no dates — it is what
 * the map needs about a trip — and the pairing is a fact about the content
 * collection. Three walks fall inside Chengdu and one inside Phuket; `walkedOn`
 * throws at build time if a route ever falls inside two trips at once.
 *
 * `Object.fromEntries` because the value crosses into the page as JSON, and a
 * Map does not survive that.
 */
const walkedOn: Record<string, string[]> = Object.fromEntries(
  [...walkedOnTrips(trips, trails)].map(([id, routes]) => [id, routes.map((route) => route.id)]),
);

/**
 * The redesigned section underneath needs more about each trip than the map
 * does — the dates to place it on its timeline, the country and the summary
 * for its panel, and the photo for its wall: the `cover` the timeline above
 * draws, or a cover.* dropped into the trip's folder (see `tripPhotos`).
 * Dates are formatted by the same lib/content.ts helpers the timeline uses, so
 * the two cannot print a trip differently.
 */
const photos = await tripPhotos(trips);
const showcaseTrips: ShowcaseTrip[] = trips.map((trip) => ({
  id: trip.id,
  label: trip.data.title.split(',')[0]!.trim(),
  country: trip.data.country ?? null,
  when: tripYear(trip.data) ?? 'Undated',
  dates: formatTripDates(trip.data) ?? 'Dates to confirm',
  start: trip.data.start ?? null,
  summary: trip.data.summary ?? null,
  href: `/about/travel/${trip.id}`,
  cover: photos.get(trip.id),
}));
---

<BaseLayout
  title="Travel — globe preview"
  description="The travel timeline with a 3D earth under it: the places visited and the routes walked."
  noindex
>
  <Fragment slot="head">
    <script is:inline>
      try {
        if (localStorage.getItem("trips-view") === "compact") {
          document.documentElement.classList.add("trips-compact");
        }
      } catch (e) {}
    </script>
  </Fragment>

  <TravelContent
    title={entry.data.title}
    summary={entry.data.summary}
    rows={rows}
    tripCount={trips.length}
    placeCount={places.size}
    prev={prev}
    next={next}
  >
    {/* Keep the <a> on the same line as the words before it: Astro drops the
        whitespace between a text node and a tag that opens the next line, and
        this sentence shipped as "butthe real travel page" that way. */}
    <p class="preview-flag" slot="header-extra">
      <span class="preview-flag__tag">Preview</span>
      <span>
        The travel page with a map under the timeline. Not linked from anywhere but <a
        href="/about/travel">the real travel page</a>.
      </span>
    </p>

    <MapGlobeStage slot="after-timeline" trips={mapTrips} walkedOn={walkedOn} />
    <MapShowcase slot="after-timeline" trips={showcaseTrips} walkedOn={walkedOn} />

    <Content slot="essay" />
  </TravelContent>
</BaseLayout>

<script>
  import '../../scripts/trips-view';
  import '../../scripts/mapglobe';
  import '../../scripts/mapglobe/showcase';
</script>

<style>
  @reference "#styles";

  .preview-flag {
    @apply mt-2 flex flex-wrap items-center gap-2 text-sm text-fg-meta;
  }

  .preview-flag__tag {
    @apply rounded-full border border-accent/40 px-2 py-0.5;
    @apply font-mono text-[0.65rem] tracking-[0.12em] text-accent uppercase;
  }

  .preview-flag a {
    @apply text-accent underline decoration-accent/30 underline-offset-2 hover:decoration-accent;
  }
</style>
