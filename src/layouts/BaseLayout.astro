---
import "../styles/global.css";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import { DEFAULT_THEME_ID, THEME_IDS } from "../lib/themes";

interface Props {
  /** Page title. Rendered as `<title> · Lee Cheng Zhan` unless isHome. */
  title: string;
  /** Meta description. Keep under ~160 characters. */
  description: string;
  /** Path to an OG image under public/. Falls back to the hero shot. */
  ogImage?: string;
  /** Home page uses the bare site name rather than the suffixed form. */
  isHome?: boolean;
  /** Keep out of search results. Used by 404 and any thin/utility page. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/assets/images/home-landscape-image-1.png",
  isHome = false,
  noindex = false,
} = Astro.props;

const SITE_NAME = "Lee Cheng Zhan";
const fullTitle = isHome ? `${SITE_NAME} · Software Engineer` : `${title} · ${SITE_NAME}`;

// TODO(domain): Astro.site is https://leechengzhan.com, which is NOT REGISTERED YET.
// Canonical + OG URLs below are built from it, so they currently point at a domain
// that does not resolve. This is harmless while the site is unpublished, but it
// MUST be registered (or `site` changed in astro.config.mjs) before any public
// deploy — otherwise search engines follow canonicals into a dead domain.
// See docs/REBUILD.md §12.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// The pre-paint bootstrap, built here so the theme id list has exactly one
// home. Kept deliberately small — it is inline on every page, and it runs
// before the browser has painted anything. See the comment at its <script>.
const bootstrap = `
document.documentElement.classList.add("js");
try {
  var t = localStorage.getItem("theme");
  if (t === "dark") {
    document.documentElement.classList.add("dark");
    document.getElementById("theme-color")?.setAttribute("content", "#0d0d0f");
  }
  var l = localStorage.getItem("light-theme");
  if (l && l !== ${JSON.stringify(DEFAULT_THEME_ID)} && ${JSON.stringify(THEME_IDS)}.indexOf(l) !== -1) {
    document.documentElement.classList.add("theme-" + l);
  }
} catch (e) {}
`.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/assets/icon/cz.png" />
    <link rel="apple-touch-icon" href="/assets/icon/cz.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Retargeted by the inline script below and by src/scripts/theme.ts to
         match the resolved theme. The value here is only the light default —
         it is what a no-JS visitor gets. -->
    <meta id="theme-color" name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Runs before first paint, and does three jobs.
         1. Marks the document script-capable. global.css gates every
            `opacity: 0` reveal starting state behind `html.js`, so a JS failure
            degrades to "no animation" rather than "no visible content".
         2. Applies the dark theme if the visitor has chosen it, so the page
            paints dark once rather than flashing light first.
         3. Applies the chosen light theme, for the same reason — a stored
            `.theme-sage` added after paint is a visible repaint of the whole
            page.

         The two are separate keys because they are separate axes: a light
         choice is remembered underneath dark and comes back when dark is
         switched off. See src/scripts/theme.ts.

         Light is the default, Classic is the default light theme, and the OS is
         deliberately not consulted on either — there is no matchMedia call and
         no `.light` class. The stored id is checked against the real list
         rather than pasted into a class name, so a hand-edited localStorage
         cannot inject one.

         `is:inline` is required: a bundled or module script runs after paint,
         which would show the wrong theme and then repaint.

         The try/catch is not optional. localStorage throws outright in some
         privacy modes, and an uncaught throw here would take the `js` class
         above down with it — leaving every reveal animation stuck hidden.

         Written with `set:html` so THEME_IDS comes from src/lib/themes.ts
         rather than being restated here — one list, and the picker, the CSS and
         this script all read it. -->
    <script is:inline set:html={bootstrap} />

    <!-- For page-specific pre-paint work only. `/about/travel` uses it to
         restore a stored layout choice before the timeline is parsed; putting
         that script here rather than in the block above keeps its cost off the
         other fourteen pages. Renders nothing when a page passes nothing. -->
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="sr-only skip-link">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Smooth scroll + the ScrollTrigger wiring. Loaded as a module so it is
      // deferred automatically. This is a plain script, NOT a React island —
      // Lenis is page-wide behaviour, not a component.
      import "../scripts/smooth-scroll";
      import "../scripts/reveal";
      // Clipboard buttons in the footer. Event-delegated, so one listener
      // covers every button on the page.
      import "../scripts/copy";
      // Theme toggle. The initial theme is already applied by the inline
      // script in <head>; this only handles the click.
      import "../scripts/theme";
    </script>
  </body>
</html>
