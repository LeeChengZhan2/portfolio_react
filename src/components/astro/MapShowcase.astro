---
/**
 * THE SHOWCASE — the MapLibre earth with a redesigned frontend, directly under
 * the original section on /about/travel-preview so the two can be compared on
 * one page (24 Nov 2026, author's request: "duplicate the MapLibre section
 * below it and re-design the frontend — an impressive version").
 *
 * Same engine (src/scripts/mapglobe/engine.ts), same data, same colour
 * contract. What changed is everything the reader touches, and every change
 * traces to the design research done for it (recorded in CLAUDE.md):
 *
 *   - ONE MAP, NO TABS. World, then a place, then a trail, entered from the map
 *     or the timeline, with a breadcrumb as the way back. Layers live behind
 *     one button.
 *   - ONE PHOTO AT A TIME INSTEAD OF FIGURES (25–26 Nov 2026, author's
 *     request). One line, then the trips' photos in one frame, taking turns —
 *     no title, no counts and no dates anywhere a glance lands: "I just want
 *     to show I like to travel at a glance with the earth view." No title
 *     because "everyone know this is trips". Where the photos come from is
 *     tripPhotos() in lib/content.ts.
 *   - TWO VIEWS, TWO SUBJECTS. Globe is the trips: their photos, and the
 *     earth with the places on it. Terrain is the trails: every route at once
 *     (the engine's terrain mode and its overview, never one route nobody
 *     picked), and the panel turns into a wall of route outlines.
 *   - A TOUR. The trips in the order they happened, one camera flight each,
 *     with a caption, and pause / previous / next / end at every step — only
 *     ever started by the reader (WCAG 2.2.2).
 *   - A FLYOVER. A trail flown in 3D: an eased follow camera over the real
 *     terrain, the line drawing itself on, the profile's playhead keeping pace.
 *     Pause, speed, scrub and re-centre, after Strava, AllTrails and Komoot;
 *     any gesture pauses it.
 *   - A CHRONOLOGY, KEPT FOR THE AUTHOR. One timeline that every trip and
 *     every local trail sits on, out of sight with nothing on the page that
 *     says it exists. It slides up when a mouse reaches the foot of the map
 *     (25 Nov 2026: "I want to remain this for me only ... user no need to
 *     know about the timeline"). Touch never meets it.
 *   - SOLID PANELS FOR TEXT, GLASS ONLY FOR SMALL CONTROLS. Text never floats
 *     on hillshade. The detail panel docks to the right on a desktop and is a
 *     bottom sheet with three heights on a phone, so the map stays visible.
 *
 * Not an island: src/scripts/mapglobe/showcase.ts is a few hundred bytes that
 * import the app and the engine when the stage is a screen away.
 *
 * Every rule below is a plain declaration on the theme tokens — no `@apply` —
 * so nothing in this file can add to the stylesheet all 25 pages share.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MapTrail } from '../../scripts/mapglobe/engine';
import trails from '../../data/trails.json';

export interface ShowcaseTrip {
  id: string;
  label: string;
  country: string | null;
  when: string;
  dates: string;
  start: string | null;
  summary: string | null;
  href: string;
  /** The trip's photo, for the wall. Build-time only: it never reaches the
      app's payload. */
  cover?: CollectionEntry<'trips'>['data']['cover'];
}

interface Props {
  trips: ShowcaseTrip[];
  walkedOn: Record<string, string[]>;
}

const { trips, walkedOn } = Astro.props;
const routes = trails as MapTrail[];

/* ---- what kind of walk each trail is (25 Nov 2026) ------------------------ */
/** A hike that gains this much is a climb — up a mountain rather than along a
    path. The routes split cleanly on it: Belumut, Pulai and Lambak gain 529 m
    and more, the Changping valley legs and Cape Krathing 316 m and less. The
    manifest only knows hike and run, so the third kind is decided here, once,
    and handed to the app and the engine rather than worked out again. Above
    the timeline, which marks its trails by kind too. */
const CLIMB_ASCENT_M = 400;
type TrailKind = 'climb' | 'hike' | 'run';
const KINDS: TrailKind[] = ['climb', 'hike', 'run'];
const KIND_NAME: Record<TrailKind, string> = { climb: 'Climbs', hike: 'Hikes', run: 'Runs' };
const kindOf = (route: MapTrail): TrailKind =>
  route.kind === 'run' ? 'run' : (route.ascent ?? 0) >= CLIMB_ASCENT_M ? 'climb' : 'hike';

/* ---- the chronology ------------------------------------------------------ */
const DAY = 86_400_000;
/** A partial date's place on the axis: a month-precision trip sits mid-month,
    a year-precision one mid-year — never on a day nobody wrote down. */
const at = (value: string): number => {
  const [y, m, d] = value.split('-').map(Number);
  if (m === undefined) return Date.UTC(y!, 6, 1);
  if (d === undefined) return Date.UTC(y!, m - 1, 15);
  return Date.UTC(y!, m - 1, d);
};

const onTrips = new Set(Object.values(walkedOn).flat());
// A trail walked on a trip is reached through that trip; the timeline carries
// the trips and the trails that belong to no trip — the six near home.
const local = routes.filter((route) => !onTrips.has(route.id));
const dated = trips.filter((trip): trip is ShowcaseTrip & { start: string } => trip.start !== null);
const times = [...dated.map((trip) => at(trip.start)), ...local.map((route) => at(route.date))];
const t0 = Math.min(...times) - 40 * DAY;
const t1 = Math.max(...times) + 40 * DAY;
const pct = (t: number): number => ((t - t0) / (t1 - t0)) * 100;

const plural = (n: number, word: string): string => `${n} ${word}${n === 1 ? '' : 's'}`;

interface Tick {
  kind: 'trip' | TrailKind;
  id: string;
  label: string;
  sub: string;
  aria: string;
  t: number;
}

const ticks: Tick[] = [
  ...dated.map((trip): Tick => {
    const n = (walkedOn[trip.id] ?? []).length;
    const walked = n ? ` · ${plural(n, 'trail')}` : '';
    return {
      kind: 'trip',
      id: trip.id,
      label: trip.label,
      sub: `${trip.dates}${walked}`,
      aria: `${trip.label}${trip.country ? `, ${trip.country}` : ''}: ${trip.dates}${walked ? `, ${plural(n, 'trail')}` : ''}`,
      t: at(trip.start),
    };
  }),
  ...local.map(
    (route): Tick => ({
      kind: kindOf(route),
      id: route.id,
      label: route.label,
      sub: `${route.when} · ${route.km.toFixed(1)} km`,
      aria: `${route.label}, ${kindOf(route)}: ${route.when}, ${route.km.toFixed(1)} km`,
      t: at(route.date),
    }),
  ),
].sort((a, b) => a.t - b.t);

const firstYear = new Date(t0).getUTCFullYear();
const lastYear = new Date(t1).getUTCFullYear();
const years: { label: string; pct: number }[] = [];
for (let y = firstYear + 1; y <= lastYear; y++) years.push({ label: String(y), pct: pct(Date.UTC(y, 0, 1)) });

/* ---- the trail outlines, for the Terrain view's panel --------------------- */
/* Each route drawn as its own shape: read at build time off the same geometry
   file the map fetches, flattened by the cosine of its latitude so a walk is
   not stretched east to west, fitted into a 100-unit square, and thinned to
   what a tile 5rem across can show. Nothing here is fetched at runtime, and a
   file that cannot be read leaves its tile with a name and no outline. */
const SHAPE_PAD = 6;

/** Ramer–Douglas–Peucker: keep only the points that bend the line. */
function thin(points: [number, number][], tolerance: number): [number, number][] {
  if (points.length < 3) return points;
  const keep = new Uint8Array(points.length);
  keep[0] = 1;
  keep[points.length - 1] = 1;
  const spans: [number, number][] = [[0, points.length - 1]];
  while (spans.length) {
    const [a, b] = spans.pop()!;
    const [ax, ay] = points[a]!;
    const [bx, by] = points[b]!;
    const dx = bx - ax;
    const dy = by - ay;
    const length = Math.hypot(dx, dy);
    let far = -1;
    let farthest = tolerance;
    for (let i = a + 1; i < b; i++) {
      const [px, py] = points[i]!;
      // A span whose two ends are one point has no line to measure from, so
      // the distance is to that point. A walk that finishes where it started
      // begins as one. Measured off a line of no length instead, every point
      // scores zero and the whole shape is thinned away to a dot — which is
      // what happened to the city outlines this panel drew until 25 Nov 2026.
      const off = length ? Math.abs(dx * (py - ay) - dy * (px - ax)) / length : Math.hypot(px - ax, py - ay);
      if (off > farthest) {
        far = i;
        farthest = off;
      }
    }
    if (far > 0) {
      keep[far] = 1;
      spans.push([a, far], [far, b]);
    }
  }
  return points.filter((_, i) => keep[i]);
}

/** In the 100-unit square, where a unit is about half a pixel on a tile. */
const TOLERANCE = 0.5;

/** A walk's line of [lon, lat], fitted into the 100-unit square. */
function shapeOf(line: [number, number][]): { d: string; start: [number, number] } | null {
  if (line.length < 2) return null;
  const k = Math.cos((line.reduce((sum, [, lat]) => sum + lat, 0) / line.length) * (Math.PI / 180));
  const xs = line.map(([lon]) => lon * k);
  const ys = line.map(([, lat]) => -lat);
  const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
  const scale = (100 - 2 * SHAPE_PAD) / (Math.max(x1 - x0, y1 - y0) || 1);
  const ox = (100 - (x1 - x0) * scale) / 2;
  const oy = (100 - (y1 - y0) * scale) / 2;
  const points = thin(
    line.map(([lon, lat]): [number, number] => [ox + (lon * k - x0) * scale, oy + (-lat - y0) * scale]),
    TOLERANCE,
  );
  return {
    d: points.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(''),
    start: points[0]!,
  };
}

function outlineOf(id: string): { d: string; start: [number, number] } | null {
  try {
    return shapeOf(JSON.parse(readFileSync(join(process.cwd(), 'public', 'globe', 'trails', `${id}.json`), 'utf8')));
  } catch {
    return null;
  }
}

/* The manifest's own order within each kind: newest first. */
const outlines = routes.map((route) => ({ route, outline: outlineOf(route.id) }));

/* ---- the reel, for the Globe view's panel --------------------------------- */
/* The order the photos come round in: newest first, which is the order
   getTrips() hands them over in, but the trips with a photo together and ahead
   of the ones still waiting for theirs. */
const reel = [...trips.filter((trip) => trip.cover), ...trips.filter((trip) => !trip.cover)];

/* A sign for each kind: a summit flag on a peak, a walker with a pole, a runner.
   One drawing per kind, as 16-unit strokes, painted everywhere as a CSS mask
   filled with the text colour. The drawings reach the CSS as custom
   properties set on the section, so the panel, the filter, the trail panel
   and the cards on the map all draw the same one — including the cards the
   engine builds and the panels the app builds, which no markup here reaches. */
const KIND_ICON: Record<TrailKind, string[]> = {
  climb: ['M1.5 14.25 6.75 5.5 9.1 9.35 10.75 6.9 14.5 14.25Z', 'M6.75 5.5V1.5', 'M6.75 1.6 10.25 2.75 6.75 3.9'],
  hike: [
    'M9.6 2.3a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 1 1 2.6 0Z',
    'M8 4.4 7.1 8.7',
    'M7.1 8.7 8.6 11.4 8.9 14.6',
    'M7.1 8.7 6 11.6 4.6 14.6',
    'M7.8 5.2 10.4 7.3',
    'M7.7 5.3 5.7 7.4',
    'M10.9 5.6 11.6 14.6',
  ],
  run: [
    'M11.7 2.4a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 1 1 2.6 0Z',
    'M9.6 4.5 7.6 8.6',
    'M7.6 8.6 10.3 9.9 9.5 13.9',
    'M7.6 8.6 5.9 11.2 3.1 11.6',
    'M9.3 5.2 11.3 6.6 12.9 5.6',
    'M9.1 5.4 7 5.9 5.7 7.8',
  ],
};
const iconUrl = (kind: TrailKind): string => {
  const paths = KIND_ICON[kind].map((d) => `<path d="${d}"/>`).join('');
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
const kindIcons = KINDS.map((kind) => `--xp-icon-${kind}:${iconUrl(kind)}`).join(';');

/* ---- what the app reads --------------------------------------------------- */
const payload = {
  trips: trips.map(({ start: _start, cover: _cover, ...trip }) => ({ ...trip, routes: walkedOn[trip.id] ?? [] })),
  tour: [...dated].sort((a, b) => at(a.start) - at(b.start)).map((trip) => trip.id),
  trails: routes,
  walkedOn,
  trailKinds: Object.fromEntries(routes.map((route) => [route.id, kindOf(route)])),
};
---

<section class="xp" data-xp aria-label="Trips and trails" data-state="loading" style={kindIcons}>
  <p class="xp-tag">
    <span class="xp-tag__chip">Redesign</span>
    <span>The map above, rebuilt on the same engine and data with a new frontend.</span>
  </p>

  <div class="xp-stage" data-xp-stage>
    {/* Two faces, one per view: the trips while the globe is up, the trails
        while the terrain is. CSS swaps them off the section's data-view, which
        the app sets; with no app the globe's face is the one that shows. No
        buttons on either (25 Nov 2026, author's call): the tiles are the way
        in, and the tour and the flyover are a choice inside, not a pitch.

        NO TITLE (25 Nov 2026, author's request): "dont put trips word because
        everyone know this is trips". The same is true of "Trails", so neither
        is shown; both stay as headings for a screen reader, out of sight. Each
        face has one line instead, in the same hand and at the same size on
        both: right above the photo on the Globe, at the top on the Terrain. A
        wordless version, with the names
        hidden until hovered, was tried the same day and judged ugly: "still
        can put the desc".

        Hovering a tile or the photo lights its place's card on the map, and
        hovering a card lights its tile or brings up its photo
        (showcase-app.ts), so the panel and the place on the globe can be
        matched up without reading either.

        The header is a full-height column with the face at its top. The
        engine clears a reserved box by its shape (framePadding in engine.ts):
        taller than wide is cleared sideways, anything else vertically. Sized
        to its content, the Trails face is no longer taller than wide once the
        filter hides a row, and by the engine's arithmetic the overview fit
        then fails its 45% test at 1440 and falls back to plain padding. A
        column is taller than wide at every stage height. It lets pointer
        events through to the map below the face. */}
    <header class="xp-hero" data-xp-hero data-mapglobe-reserve>
      <div class="xp-hero__face xp-hero__face--globe">
        <h2 class="xp-sr" id="xp-trips-title">Trips</h2>
        <p class="xp-hero__lede">Pick a memory to fly there.</p>
        {/* ONE PHOTO AT A TIME (26 Nov 2026, author's request): "I no need to
            show all trips and photo at a glance ... show only 1 or few frame
            at 1 time and use animation to swap it. Show the picture in so
            small frame also weird." A wall of nine tiles had been tried small,
            then at the column's width, and read as an index squeezed beside
            the earth either way. The globe already shows every trip as a
            card; this panel is for the pictures.

            So: one frame the column's width, the photo in it drifting slowly
            and swapping for the next on its own (showcase-app.ts runs it).
            Pointing at a trip's card on the globe brings that trip's photo up,
            and pointing at the photo lights the card, so the globe is the
            index and this is the picture. A click on either flies there.

            The caption is the place and its country and nothing else. Each
            trip's summary is about WHEN — the season, the month — which the
            author keeps off anything a glance lands on.

            PHOTOS ONLY (25 Nov 2026): "dont show the trips area It should
            display the photo". A trip with no photo yet holds its frame with
            the hatching the travel timeline uses, never a drawing of the
            city's built-up area. The earth has not moved through any of this:
            it is placed by the column, and the column is unchanged.

            How a photo gets in is tripPhotos() in lib/content.ts, and for the
            author src/assets/travel/README.md. The photo is decoration inside
            a button its caption already labels, so its alt is empty. */}
        <div class="xp-reel" data-xp-reel role="region" aria-roledescription="carousel" aria-labelledby="xp-trips-title">
          <div class="xp-reel__slides">
            {
              reel.map((trip, i) => (
                <div
                  class="xp-reel__slide"
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${reel.length}`}
                  data-xp-slide={trip.id}
                  data-active={i === 0 ? '' : undefined}
                  inert={i !== 0}
                >
                  <button type="button" class="xp-reel__card" data-xp-trip={trip.id}>
                    <span class="xp-reel__frame">
                      {trip.cover ? (
                        <Image
                          src={trip.cover}
                          alt=""
                          width={800}
                          widths={[400, 800]}
                          sizes="(max-width: 52rem) min(34rem, calc(100vw - 2rem)), 22rem"
                          class="xp-reel__img"
                        />
                      ) : (
                        <span class="xp-reel__hold">Photo to come</span>
                      )}
                    </span>
                    <span class="xp-reel__dwell" aria-hidden="true">
                      <span data-xp-reel-dwell />
                    </span>
                    <span class="xp-reel__caption">
                      <span class="xp-reel__place">{trip.label}</span>
                      {trip.country && (
                        <span class="xp-reel__country">
                          <span class="xp-sr">, </span>
                          {trip.country}
                        </span>
                      )}
                    </span>
                  </button>
                </div>
              ))
            }
          </div>
          <div class="xp-reel__controls">
            <button type="button" class="xp-icon-btn" data-xp-reel-step="-1" aria-label="Previous photo">
              <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="M10 3.5 5.5 8l4.5 4.5"></path></svg>
            </button>
            <button type="button" class="xp-icon-btn xp-reel__pause" data-xp-reel-pause aria-pressed="false" aria-label="Pause the photos">
              <svg class="xp-icon xp-reel__when-playing" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 3h2.6v10H4.5zM8.9 3h2.6v10H8.9z"></path></svg>
              <svg class="xp-icon xp-reel__when-paused" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 2.8v10.4L13 8 4.5 2.8Z"></path></svg>
            </button>
            <button type="button" class="xp-icon-btn" data-xp-reel-step="1" aria-label="Next photo">
              <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="m6 3.5 4.5 4.5L6 12.5"></path></svg>
            </button>
          </div>
        </div>
        {/* THE LINE (27 Nov 2026, the author's pick from a mixer of words,
            size, typeface and place): "Pick a memory to fly there.",
            handwritten, right above the photo. The Terrain face's line takes
            the same hand and size and keeps its place at the top. The photo
            does not move for it ("dont change the photo location"): the line
            hangs off the top edge of this face, out of the flow, so the photo
            stays level with the middle of the globe. Before this it was "Pick
            a trip to fly there." in the site's own sans at the top of the
            column; before that "Pick a trip to fly there, or spin the globe.",
            over the photo and then under the place's name; and for one round
            nothing, which left the face looking empty. */}
      </div>
      <div class="xp-hero__face xp-hero__face--terrain">
        <h2 class="xp-sr">Trails</h2>
        <p class="xp-hero__lede">Pick a trail to fly down to it.</p>
        {/* A row per kind under its own sign — climbs, hikes, runs — and a tile
            per route in it, drawn as its own outline in the accent, the shape
            of the walk where a trip's tile has its photo. The Terrain filter
            hides a whole row when its kind is switched off. */}
        {
          KINDS.map((kind) => {
            const members = outlines.filter(({ route }) => kindOf(route) === kind);
            return (
              members.length > 0 && (
                <div class="xp-kinds" role="group" aria-labelledby={`xp-kind-${kind}`} data-xp-kind-group={kind}>
                  <h3 class="xp-kinds__title" id={`xp-kind-${kind}`}>
                    <span class="xp-kind" data-kind={kind} aria-hidden="true" />
                    {KIND_NAME[kind]}
                  </h3>
                  <ul class="xp-wall">
                    {members.map(({ route, outline }) => (
                      <li>
                        <button type="button" class="xp-wall__tile xp-wall__tile--trail" data-xp-trail={route.id} data-kind={kind}>
                          {outline && (
                            <svg class="xp-wall__outline" viewBox="0 0 100 100" aria-hidden="true">
                              <path class="xp-wall__route" d={outline.d} />
                              <circle class="xp-wall__start" cx={outline.start[0].toFixed(1)} cy={outline.start[1].toFixed(1)} r="4" />
                            </svg>
                          )}
                          <span class="xp-wall__name">{route.label}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            );
          })
        }
      </div>
    </header>

    <div class="xp-viewport" data-xp-viewport>
      {/* The first frame, before a single byte of map has arrived: a sphere
          drawn in the theme's own colours, which the live globe crossfades
          over. An SVG with `meet` sizing, so its circle is always 86% of the
          smaller side — the same size the engine's home camera draws. */}
      <svg class="xp-ghost" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <radialGradient id="xp-ghost-fill" cx="0.36" cy="0.32" r="0.75">
            <stop offset="0" class="xp-ghost__hi"></stop>
            <stop offset="1" class="xp-ghost__lo"></stop>
          </radialGradient>
        </defs>
        <circle cx="50" cy="50" r="43" fill="url(#xp-ghost-fill)" class="xp-ghost__sphere"></circle>
        <ellipse cx="50" cy="50" rx="43" ry="15" class="xp-ghost__line"></ellipse>
        <ellipse cx="50" cy="50" rx="17" ry="43" class="xp-ghost__line"></ellipse>
        <line x1="7" y1="50" x2="93" y2="50" class="xp-ghost__line"></line>
      </svg>

      <div class="xp-map" data-xp-map></div>
      <div class="xp-labels" data-xp-labels></div>

      <nav class="xp-crumbs" aria-label="Where you are on the map" data-xp-crumbs hidden></nav>

      <div class="xp-controls" data-mapglobe-reserve>
        <div class="xp-seg" role="radiogroup" aria-label="Map view">
          <button type="button" role="radio" aria-checked="true" data-xp-view="globe">
            <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><circle class="xp-icon__stroke" cx="8" cy="8" r="6"></circle><path class="xp-icon__stroke" d="M2 8h12M8 2c2 2.2 2 9.8 0 12M8 2c-2 2.2-2 9.8 0 12"></path></svg>
            <span>Globe</span>
          </button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-xp-view="survey">
            <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="M1.5 13 6 5.5l2.6 4L10.5 7l4 6Z"></path></svg>
            <span>Terrain</span>
          </button>
        </div>
        <span class="xp-controls__rule" aria-hidden="true"></span>
        <div class="xp-layers-wrap">
          <button
            type="button"
            class="xp-icon-btn"
            aria-expanded="false"
            aria-controls="xp-layers"
            aria-label="Map layers"
            title="Map layers"
            data-xp-layers-toggle
          >
            <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="M8 2 1.8 5.4 8 8.8l6.2-3.4L8 2ZM1.8 8.2 8 11.6l6.2-3.4M1.8 11 8 14.4l6.2-3.4"></path></svg>
