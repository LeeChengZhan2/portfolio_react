            <fieldset class="xp-layers__group xp-layers__group--globe">
              <legend>On the map</legend>
              <label class="xp-switch"><span>Trips</span><input type="checkbox" data-xp-content="trips" checked /></label>
              <label class="xp-switch"><span>Trails</span><input type="checkbox" data-xp-content="trails" checked /></label>
            </fieldset>
            <fieldset class="xp-layers__group xp-layers__group--globe">
              <legend>Detail</legend>
              <label class="xp-switch"><span>Countries</span><input type="checkbox" data-xp-layer="countries" checked /></label>
              <label class="xp-switch"><span>Cities</span><input type="checkbox" data-xp-layer="cities" /></label>
              <label class="xp-switch"><span>Relief</span><input type="checkbox" data-xp-layer="relief" checked /></label>
              <label class="xp-switch"><span>Peaks</span><input type="checkbox" data-xp-layer="peaks" /></label>
              <label class="xp-switch"><span>Rivers &amp; lakes</span><input type="checkbox" data-xp-layer="water" /></label>
            </fieldset>
            <p class="xp-layers__keys">
              <kbd>Esc</kbd> closes a panel or stops a flyover
            </p>
          </div>
        </div>
        <button type="button" class="xp-icon-btn" aria-label="Back to the whole globe" title="Back to the whole globe" data-xp-home>
          <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><circle class="xp-icon__stroke" cx="8" cy="8" r="2.4"></circle><path class="xp-icon__stroke" d="M8 1.5v2.5M8 12v2.5M1.5 8H4M12 8h2.5"></path></svg>
        </button>
        <button type="button" class="xp-icon-btn" aria-label="Full screen" aria-pressed="false" title="Full screen" data-xp-fullscreen>
          <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10"></path></svg>
        </button>
      </div>

      <aside class="xp-sheet" data-xp-sheet data-mapglobe-reserve data-detent="peek" aria-labelledby="xp-sheet-title" hidden>
        <div class="xp-sheet__bar">
          <button type="button" class="xp-grabber" data-xp-grabber aria-label="Show more of the panel">
            <span aria-hidden="true"></span>
          </button>
