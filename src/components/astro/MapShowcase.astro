          <p class="xp-hud__clock"><span>Local time</span> <span class="xp-hud__time" data-xp-hud-clock>--:--</span></p>
        </div>
        <div class="xp-hud__nums">
          <p><span class="xp-num" data-xp-hud-km>0.0</span> <span class="xp-hud__unit" data-xp-hud-total></span></p>
          <p><span class="xp-num" data-xp-hud-ele>0</span> <span class="xp-hud__unit">m elevation</span></p>
        </div>
        <div
          class="xp-hud__bar"
          data-xp-hud-bar
          role="slider"
          tabindex="0"
          aria-label="Flyover position"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <span class="xp-hud__fill" aria-hidden="true"></span>
        </div>
        <div class="xp-hud__controls">
          <button type="button" class="xp-icon-btn xp-icon-btn--solid" aria-label="Pause the flyover" data-xp-hud-pause>
            <svg class="xp-icon xp-when-running" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 3h2.6v10H4.5zM8.9 3h2.6v10H8.9z"></path></svg>
            <svg class="xp-icon xp-when-paused" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 2.8v10.4L13 8 4.5 2.8Z"></path></svg>
          </button>
          <button type="button" class="xp-text-btn xp-text-btn--chip" data-xp-hud-speed aria-label="Flyover speed: 1×">1×</button>
