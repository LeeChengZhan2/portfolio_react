        <h3 class="xp-caption__title" data-xp-caption-title></h3>
        <p class="xp-caption__text" data-xp-caption-text></p>
        <div class="xp-caption__bar" data-xp-caption-bar aria-hidden="true"></div>
        <div class="xp-caption__controls">
          <button type="button" class="xp-icon-btn" aria-label="Previous trip" data-xp-tour-prev>
            <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="M10 3.5 5.5 8l4.5 4.5"></path></svg>
          </button>
          <button type="button" class="xp-icon-btn xp-icon-btn--solid" aria-label="Pause the journey" aria-pressed="false" data-xp-tour-pause>
            <svg class="xp-icon xp-when-running" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 3h2.6v10H4.5zM8.9 3h2.6v10H8.9z"></path></svg>
            <svg class="xp-icon xp-when-paused" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__fill" d="M4.5 2.8v10.4L13 8 4.5 2.8Z"></path></svg>
          </button>
          <button type="button" class="xp-icon-btn" aria-label="Next trip" data-xp-tour-next>
            <svg class="xp-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="xp-icon__stroke" d="m6 3.5 4.5 4.5L6 12.5"></path></svg>
          </button>
          <span class="xp-spacer"></span>
          <button type="button" class="xp-text-btn" data-xp-tour-end>End tour</button>
