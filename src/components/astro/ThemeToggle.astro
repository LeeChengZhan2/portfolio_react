---
// Heroicons 24/outline, inlined — same convention as Header.astro. Both use
// stroke="currentColor", so they follow the surrounding text colour.
const MOON =
  'M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z';

const SUN =
  'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z';
---

{/*
  aria-pressed/aria-label below are the LIGHT defaults. They have to be
  something at build time — this is a static site, so the server cannot know
  the visitor's theme. src/scripts/theme.ts corrects them on load, before any
  interaction. The icon does not rely on them: it is driven by the `html.dark`
  class, which the inline head script sets pre-paint, so it is never wrong even
  for the frame before the module loads.
*/}
<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark theme">
  <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d={MOON} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d={SUN} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  @reference "#styles";

  /* Hidden without JS — the button would be inert, and an inert control is
     worse than no control. Reuses the `html.js` gate global.css already
     establishes for the reveal animations. */
  .theme-toggle {
    @apply hidden;
  }

  :global(html.js) .theme-toggle {
    @apply inline-flex h-8 w-8 flex-none items-center justify-center rounded-full text-fg-meta transition-colors;
    @apply hover:bg-surface-2 hover:text-accent;
  }

  .icon {
    @apply h-5 w-5;
  }

  /* Show the icon for the action, not the current state: a moon means "go
     dark". Keyed off the <html> class rather than aria-pressed because that
     class is set before first paint, so the correct icon renders immediately. */
  .icon--sun {
    @apply hidden;
  }

  :global(html.dark) .icon--moon {
    @apply hidden;
  }

  :global(html.dark) .icon--sun {
    @apply block;
  }
</style>
