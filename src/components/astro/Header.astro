---
import { getSections, getWork } from '../../lib/content';
import ThemeToggle from './ThemeToggle.astro';
import ThemePicker from './ThemePicker.astro';

const sections = await getSections();
const work = await getWork();

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// Heroicons 24/outline paths, inlined. The legacy site pulled in
// @heroicons/react for seven icons — a React dependency for static SVG.
const ICONS: Record<string, string> = {
  user: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z',
  globe: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582',
  camera:
    'M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z',
  chart: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z',
  briefcase:
    'M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z',
  heart:
    'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z',
};

const chevron = 'm19.5 8.25-7.5 7.5-7.5-7.5';
---

<header class="navbar">
  <nav class="nav-container" aria-label="Main">
    {/* Left of Home, and a pill rather than a `.nav-link`: it is a control, not
        a section of the site, and the shape says so before the label is read.
        It re-themes the page you are on — there is no preview route any more. */}
    <ThemePicker />

    <a href="/" class:list={['nav-link', { 'is-active': isActive('/') }]}>Home</a>

    <div class="group relative inline-block">
      <a
        href="/about"
        class:list={['nav-link inline-flex items-center gap-1', { 'is-active': isActive('/about') }]}
        aria-haspopup="true"
      >
        About Me
        <svg class="h-4 w-4 text-fg-meta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d={chevron} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <div class="dropdown">
        <div class="flex flex-col gap-1">
          {
            sections.map((section) => (
              <a href={`/about/${section.id}`} class="dropdown-item">
                <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d={ICONS[section.data.icon]} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{section.data.navLabel}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="group relative inline-block">
      <a
        href="/work"
        class:list={['nav-link inline-flex items-center gap-1', { 'is-active': isActive('/work') }]}
        aria-haspopup="true"
      >
        Work
        <svg class="h-4 w-4 text-fg-meta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d={chevron} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <div class="dropdown">
        <div class="flex flex-col gap-1">
          {
            work.map((entry) => (
              <a href={`/work/${entry.id}`} class="dropdown-item">
                <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d={ICONS.briefcase} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{entry.data.title}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <a href="/#contact" class="nav-link">Contact</a>

    <ThemeToggle />
  </nav>
</header>

<style>
  @reference "#styles";

  /* Scoped to this component automatically — no naming collisions, and it
     ships only on pages that use the header. */
  .navbar {
    @apply sticky top-0 z-50 border-b border-line bg-surface/90 p-4 backdrop-blur-md;
  }

  .nav-container {
    @apply flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:gap-x-8;
  }

  .nav-link {
    @apply relative text-sm font-semibold text-fg-body transition-colors duration-300 hover:text-accent sm:text-base;
  }

  .nav-link::after {
    @apply absolute -bottom-1 left-0 h-0.5 w-full origin-left scale-x-0 bg-accent transition-transform duration-300;
    content: '';
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    @apply scale-x-100;
  }

  /* Anchored to the trigger's right edge on narrow screens, centred under it
     from `sm` up. Centring at every width is what made a 15rem panel hang past
     the viewport: the dropdown still takes part in layout while invisible, so
     that overhang is 48px of sideways scroll on a 390px phone, on every page,
     with nothing visible to explain it. Right-anchoring cannot overhang —
     the trigger's right edge is inside the viewport by definition. */
  .dropdown {
    @apply invisible absolute right-0 z-50 mt-2 w-60 translate-y-1 rounded-xl bg-surface/95 p-2 opacity-0 shadow-xl ring-1 ring-line backdrop-blur-md transition-all duration-150;
    @apply sm:right-auto sm:left-1/2 sm:-translate-x-1/2;
    @apply group-hover:visible group-hover:translate-y-0 group-hover:opacity-100;
    @apply group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100;
  }

  .dropdown-item {
    @apply flex items-center gap-2 rounded-md px-3 py-2 text-sm text-fg-body transition-colors;
    @apply hover:bg-surface-2 hover:text-accent focus:bg-surface-2 focus:text-accent;
  }

  .dropdown-icon {
    @apply h-5 w-5 flex-none text-fg-faint;
  }

  .dropdown-item:hover .dropdown-icon,
  .dropdown-item:focus .dropdown-icon {
    @apply text-accent;
  }
</style>
