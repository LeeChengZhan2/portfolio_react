---
/**
 * The MapLibre earth — the second section on /about/travel-preview, sitting
 * directly under GlobeStage so the two renderers can be compared in the same
 * page, in the same theme, on the same data.
 *
 * The comparison is deliberately narrow. Both earths read the same
 * public/globe/land.json and the same visited footprints, and both derive every
 * colour through src/scripts/globe/palette.ts. What differs is what each one
 * can DO, which is what the two modes are:
 *
 *   explore — "Trips". The globe with a filter row over it. It starts at
 *             boundaries and country names alone, both local files, so entering
 *             it makes no third-party request; city names, relief, peaks and
 *             water are added a chip at a time and each is fetched only when it
 *             is asked for. The eight footprints are drawn whatever the filters
 *             say — they are the point of the page, not a layer.
 *   terrain — "Trails". TWO VIEWS, not one (9 Sep 2026). It opens on an
 *             overview of every recorded route, each area named on a card the
 *             way the trips are; clicking a card drops to that one route on a
 *             ridge at 20 m per pixel. It used to open inside a single route
 *             with the other nine reachable only from a chip, which put the
 *             collection behind a control instead of on the map.
 *             The routes are the author's own GPX exports, simplified and
 *             measured at build time by scripts/build-trails.mjs. Dropping a
 *             .gpx on the frame was removed 7 Sep 2026 — the routes are built
 *             in now, so the page had nothing left to ask for.
 *
 * TWO MODES, AND THERE WERE FOUR UNTIL 7 SEP 2026. `places` — the bare stylised
 * globe — and `atlas` — the same globe frozen at boundaries, names and relief —
 * came off at the author's request, and nothing went with them: `explore` opens
 * on what `atlas` drew minus its relief, and switching its two default chips
 * off leaves exactly what `places` drew. Two fixed positions on a dial, sitting
 * in the row beside the dial.
 *
 * THE CHIP LABELS ARE NOT THE MODE IDS, deliberately — see the note in
 * modes.ts. "Trips" and "Trails" are both already taken by data types here:
 * a MapTrip is one visited city, a MapTrail is one recorded route.
 *
 * Both modes are things the three.js engine cannot grow into: its normal map
 * stores a shading vector rather than a height, and it has no names at all.
 *
 * Not an island. See src/scripts/mapglobe/index.ts — a dynamic import behind an
 * IntersectionObserver, the same deferral `client:visible` would give without
 * pulling React onto the page.
 *
 * Throwaway, like the section above it. When one of the two wins, delete the
 * loser and this whole preview route with it.
 */
import type { MapTrail, MapTrip } from '../../scripts/mapglobe/engine';
/**
 * The recorded routes, read at BUILD time and rendered into the picker below.
 *
 * This is why the manifest lives in src/data/ rather than in public/globe/ with
 * the geometry: nothing fetches it. The chips are static markup, the same
 * inline JSON handoff the trips already use carries the figures the readout
 * needs, and the only thing that crosses the network at runtime is the geometry
 * for a route someone actually clicks — 0.5 to 2 KB gzipped each.
 *
 * Regenerate with `node scripts/build-trails.mjs`.
 */
import trails from '../../data/trails.json';
/* Values, not just types — but this is frontmatter, which runs at build time
   only, so importing them here adds nothing to what the browser downloads. The
   client reaches the same module through the <script> at the foot of this file. */
import {
  DEFAULT_CONTENT,
  DEFAULT_LAYERS,
  DEFAULT_VIEW,
  MAP_CONTENT,
  MAP_LAYERS,
  MAP_VIEWS,
  type MapContent,
  type MapLayer,
  type MapView,
} from '../../scripts/mapglobe/modes';

interface Props {
  trips: MapTrip[];
  /**
   * Which recorded routes were walked on each trip, keyed by trip id.
   *
   * Derived by `walkedOn` in src/lib/content.ts from a route's date falling
   * inside a trip's range, and passed down rather than worked out here because
   * `MapTrip` deliberately carries no dates — it is what the MAP needs about a
   * trip, and the pairing is a fact about the content collection.
   *
   * Three walks fall inside the Chengdu trip and one inside Phuket. The index
   * rail is the first thing on the site to say so out loud.
   */
  walkedOn: Record<string, string[]>;
}

const { trips, walkedOn } = Astro.props;

/**
 * The two modes, in switcher order — the globe first, because it is what the
 * section is about and the cheaper of the two to arrive in.
 *
 * The names are the author's (7 Sep 2026) and they are a matched pair on
 * purpose: both are one word, both are already true of the data behind them —
 * visited.json holds trips, trails.json holds trails — so neither label can
 * drift from what its tab shows. They are also short enough that the switcher
 * stays on one line at 390px, which "Places visited" and "Trail terrain" did
 * not manage between them.
 *
 * `id` is what everything else keys off and it does NOT track these labels. See
 * modes.ts for why: `trips` and `trails` are taken.
 */
const MODES = [
  {
    id: 'explore',
    name: 'Trips',
    hint:
      'The globe, with a filter row. Starts at boundaries and country names — ' +
      'everything else is a chip away, and nothing is downloaded until you ask.',
  },
  {
    id: 'terrain',
    name: 'Trails',
    hint:
      'Every recorded route at once, then one at a time on real elevation. ' +
      'Fetches DEM tiles when you switch to it.',
  },
  {
    id: 'combined',
    name: 'All',
    hint:
      'Both halves on one globe — the places visited and the routes walked, ' +
      'each behind its own chip, over the same five layers. Tilt it with the ' +
      'View switch.',
  },
] as const;

/**
 * The `All` tab's two content chips.
 *
 * A `Record<MapContent, …>` for the same reason `LAYER_COPY` is one: adding a
 * member to MAP_CONTENT and forgetting its chip should be a build error, not a
 * filter nobody can reach.
 */
const CONTENT_COPY: Record<MapContent, { name: string; hint: string }> = {
  trips: { name: 'Trips', hint: 'The eight visited places, picked out in the accent.' },
  trails: {
    name: 'Trails',
    hint: 'The ten recorded routes, grouped by area. Click one to fly to it.',
  },
};

/**
 * The `All` tab's view switch.
 *
 * A `Record<MapView, …>` for the same reason LAYER_COPY and CONTENT_COPY are:
 * adding a view and forgetting its label should be a build error rather than a
 * control nobody can reach.
 *
 * The hint on `terrain` says relief comes with it, because that is the one
 * thing about this control a reader cannot predict from its label — everything
 * else it does is visible the moment it is pressed.
 */
const VIEW_COPY: Record<MapView, { name: string; hint: string }> = {
  globe: {
    name: 'Globe',
    hint: 'The flat sphere. What this tab has always opened as — no tilt, no terrain.',
  },
  route: {
    name: 'Terrain 1',
    hint:
      'One route, the whole of it in frame, on real 3D terrain. Click any route ' +
      'card to re-aim it — you stay in this tab.',
  },
  region: {
    name: 'Terrain 2',
    hint:
      'The same route with its whole mountain region around it — six times the ' +
      'extent, so the ranges are the subject and the walk is a thread through them.',
  },
  tilted: {
    name: 'Terrain 3',
    hint:
      'The whole world, leaned over and shaded. The only terrain view that keeps ' +
      'every trip in frame — and the only one with no real 3D relief, because the ' +
      'mesh cannot be attached at this scale.',
  },
  survey: {
    name: 'Terrain 4',
    hint:
      'Terrain 2 to start with, dropping to Terrain 1 when you pick a single ' +
      'route — and the index down the side reaches every trip and every route ' +
      'from either scale, so you never have to zoom out to change subject.',
  },
};

/**
 * The chip copy, keyed by layer id.
 *
 * A `Record<MapLayer, …>` rather than a list, so adding a layer to MAP_LAYERS
 * and forgetting its chip is a build error rather than a filter that silently
 * cannot be reached. The row renders in MAP_LAYERS order, which is where that
 * order is decided.
 */
const LAYER_COPY: Record<MapLayer, { name: string; hint: string }> = {
  countries: { name: 'Countries', hint: 'Boundaries, and the name of every country.' },
  cities: { name: 'Cities', hint: 'City dots and names. Capitals get a larger dot.' },
  relief: { name: 'Relief', hint: 'Shaded terrain. This is the layer that fetches DEM tiles.' },
  peaks: { name: 'Peaks', hint: '632 named mountains, with their height. Marked ▲.' },
  water: { name: 'Rivers & lakes', hint: 'Major rivers and lakes, in the sea colour.' },
};

/**
 * The routes, split into the two rows the picker shows.
 *
 * Order inside each row is the manifest's own — hikes before runs, newest
 * first — so the build script's sort is the only place that ordering is
 * decided. A kind with no routes drops its row entirely rather than rendering
 * an empty one.
 *
 * `routes[0]` used to be the route terrain mode opened on. Since 9 Sep 2026 it
 * opens on the overview of all of them and no route is special, so the ordering
 * is now only what the reader reads down.
 */
/* The assertion is the seam between a generated file and a checked one:
   TypeScript reads `kind` out of JSON as `string` and cannot know that
   scripts/build-trails.mjs only ever writes 'hike' or 'run'. That script is the
   guarantee; this is the line where it is taken on trust. */
const routes = trails as MapTrail[];
const KINDS = [
  { id: 'hike', name: 'Hikes' },
  { id: 'run', name: 'Runs' },
] as const;

/** The whole of a route in one line, for the chip's tooltip: a five-word chip
    cannot say where or when, and both are the first things anyone asks. */
const routeHint = (route: MapTrail): string =>
  [
    route.place,
    route.when,
    `${route.km.toFixed(1)} km`,
    route.ascent === null ? null : `${route.ascent.toLocaleString()} m ascent`,
  ]
    .filter(Boolean)
    .join(' · ');

/* ---- the index rail ------------------------------------------------------ *
 * Every trip and every route as one list, with the routes walked on a trip
 * nested under it.
 *
 * THIS IS NAVIGATION, NOT A FILTER, and that is why it is a list of proper
 * nouns rather than a row of chips. It exists because of one objection to
 * Terrain 2 (10 Sep 2026): at the scale that puts a mountain range in frame,
 * everything else the page has to show is off it, so changing subject meant
 * zooming out to find another card and zooming back in — which is the map
 * being used as a menu. The rail is the menu, so the map does not have to be.
 *
 * The nesting is the relationship the site records nowhere else. It was a
 * hardcoded table in the interaction mock-up below, offered as an argument;
 * `walkedOn` in src/lib/content.ts derives it from the dates now, and this is
 * the first thing to render it.
 * -------------------------------------------------------------------------- */

interface IndexGroup {
  /** Null for the one group that is not a trip — see below. */
  trip: MapTrip | null;
  name: string;
  routes: MapTrail[];
}

/**
 * What to call a group of routes, from what its members say about themselves.
 *
 * `place` is "Johor, Malaysia" or "Changping Valley, Chuanxi, China", so the
 * first segment is the area; most common wins and a tie goes to the shorter,
 * which puts five routes in "Johor" and one in "Johor Bahru" under "Johor".
 *
 * A SECOND COPY of `areaName` in engine.ts, deliberately. That module is
 * reached only through a dynamic import, and a static value import from it
 * hoists MapLibre into the eager bundle — the INEFFECTIVE_DYNAMIC_IMPORT trap
 * CLAUDE.md records, which cost this page 138 KB once already. Frontmatter runs
 * on the server and would probably be exempt, and "probably" is not worth
 * finding out for six lines. Keep them in step.
 */
function areaName(places: string[]): string {
  const counts = new Map<string, number>();
  for (const place of places) {
    const head = place.split(',')[0]!.trim();
    counts.set(head, (counts.get(head) ?? 0) + 1);
  }
  return [...counts].sort((a, b) => b[1] - a[1] || a[0].length - b[0].length)[0]![0];
}

const routeById = new Map(routes.map((route) => [route.id, route]));
const nested = new Set<string>();

/* Every trip gets a row, including the five with no walk in them — the rail is
   an index of the page, and "Tokyo, no routes" is a fact about the trip rather
   than a reason to leave it out. Trips arrive newest first from getTrips(). */
const tripGroups: IndexGroup[] = trips.map((trip) => {
  const own = (walkedOn[trip.id] ?? [])
    .map((id) => routeById.get(id))
    .filter((route): route is MapTrail => Boolean(route));
  for (const route of own) nested.add(route.id);
  return { trip, name: trip.label, routes: own };
});

/* And one group for the routes that fall inside no trip at all — six of the
   ten, all within an hour of home, which is exactly why they are not trips.
   Named after where they are rather than after what they are not: "Johor" is
   what a reader is looking for, and "No trip" is a fact about the other list. */
const loose = routes.filter((route) => !nested.has(route.id));
const indexGroups: IndexGroup[] = loose.length
  ? [...tripGroups, { trip: null, name: areaName(loose.map((route) => route.place)), routes: loose }]
  : tripGroups;

/** A trip row's second line: the year, and what was walked there. */
const placeMeta = (group: IndexGroup): string =>
  group.routes.length === 0
    ? (group.trip?.when ?? '')
    : `${group.trip?.when ?? ''} · ${group.routes.length} route${group.routes.length > 1 ? 's' : ''}`;
---

<section class="mapglobe" data-mapglobe aria-labelledby="mapglobe-heading">
  <div class="mapglobe__head">
    <p class="mapglobe__eyebrow">The alternative · MapLibre GL JS 6.6.0</p>
    <h2 id="mapglobe-heading" class="mapglobe__title">The same earth, and a mountain</h2>
    <p class="mapglobe__intro">
      The same eight footprints and the same coastline file as the earth above, drawn by a map
      engine instead of a custom renderer &mdash; so the only thing this comparison is testing is
      whether it <em>looks</em> like it belongs on the page. What it buys in exchange is the three
      tabs above the frame. <strong>Trips</strong> is the globe with a filter row over it, and it
      starts quiet &mdash; country boundaries and country names, nothing else. Add city names,
      shaded relief, named peaks or rivers and lakes a chip at a time; each layer is only
      downloaded once you ask for it, and the eight footprints stay picked out in the page&rsquo;s
      own accent whatever you switch on or off. <strong>Trails</strong> opens on
      all {routes.length} of them at once &mdash; every hike and half marathon recorded so far
      &mdash; grouped into the places they were walked, because six are inside one corner of
      Johor. It is pitched and lit like the single-route view it leads to, so the relief reads
      before you have clicked anything. Click an area to
      zoom into it and then a route to drop onto it, or pick one straight from the panel; the
      camera flies down to real elevation, and the filled dot is where the walk started while the
      ring is where it ended. Each route is drawn from a simplified line, but every figure beside
      it &mdash; distance, ascent, the elevation range &mdash; is measured from the full recording,
      so tightening the one can never quietly shorten the other. <strong>All</strong> puts both
      halves on one globe &mdash; every place visited and every route walked, each behind its own
      chip, over the same five layers &mdash; so the routes can be read in the context of the
      trips they were walked on. Three of them were, which is why two cards that would land on
      top of each other are drawn as one naming both &mdash; click it and the map zooms until
      they come apart. It is also the one tab with a <strong>View</strong> switch, and its four
      terrain positions are four answers to one trade: the 3D mesh needs a flat projection, and
      at the globe&rsquo;s 20&nbsp;km per pixel a mountain is under half a pixel of relief, so a
      whole-world view can have shading or it can have terrain and never both. <strong
      >Terrain 3</strong> keeps every trip in frame and settles for shading. <strong
      >Terrain 1</strong> and <strong>2</strong> put one walk on real elevation, framed either
      tight or with its whole mountain region around it. And <strong>Terrain 4</strong> opens
      wide like the second and drops to the first the moment you pick a single route, with an
      index down the side reaching every trip and every route from either scale &mdash; so
      changing subject never means zooming out to find something and back in again.
    </p>
    {/* MIND THE LINE BREAKS in the paragraph above, and in the note at the foot
        of this file. Astro drops the whitespace between a text node and an
        inline tag that opens the next line, so

          … switch on or off.
          <strong>Trails</strong> drops to a single route …

        renders as "switch on or off.Trails". Three of those shipped before
        anyone read the page at 390px, where the wrap made them obvious, and the
        7 Sep 2026 rename nearly added a fourth in the note at the foot. Keep an
        opening tag on the same line as the words before it — even where that
        leaves a long line, as it does above — or break inside the element. */}
  </div>

  {/*
    aria-checked ships as the default on every item and the script corrects it
    on load: a static build cannot know what the visitor stored. Same reasoning
    as GlobeStage and ThemePicker.
  */}
  <div class="switch" role="radiogroup" aria-label="Map mode">
    {MODES.map((mode) => (
      <button
        type="button"
        class="switch__opt"
        role="radio"
        aria-checked={mode.id === 'explore'}
        title={mode.hint}
        data-mapglobe-mode={mode.id}
      >
        {mode.name}
      </button>
    ))}
  </div>

  <div class="mapglobe__frame">
    <div class="mapglobe__stage" data-mapglobe-stage></div>
    <div class="mapglobe__labels" data-mapglobe-labels></div>

    {/*
      The controls sit INSIDE the frame, over the map, which is where a map's
      controls live. Three things follow from that and none is decorative:

      - The panel is a sibling of the stage, not a child of the map container,
        so MapLibre never sees a pointer event that starts on it. Drag and wheel
        over the panel do nothing to the camera, which is what you want; drag
        and wheel anywhere else are untouched.
      - It is positioned rather than laid out, so it costs the frame no height.
        At 390px the frame is 26rem and a control row above it was eating an
        eighth of the map.
      - It is hidden until `data-state="ready"`, so it never floats over the
        "Drawing the map" message.

      The chips are toggles, so they carry `aria-pressed`. They ship their
      defaults and are corrected from storage on load, like the mode switcher,
      and they are hidden without JS — a control that cannot control is worse
      than no control.
    */}
    <div class="panel filters" data-mapglobe-reserve>
      {/*
        The `All` tab's own row, and it sits ABOVE the layers rather than beside
        them because it is a different kind of question: these two chips are the
        page's own content — where the author went and what they walked — and
        the five below are the world they sit on. It renders in both globe modes
        and is hidden by CSS outside `combined`, rather than being a third panel:
        the layer chips underneath are literally the same chips in both tabs, and
        a second panel would be a second set of them to keep in step.
      */}
      {/*
        THE VIEW SWITCH, and it is first in the panel because it is the only
        control here that changes nothing about what is drawn (10 Sep 2026,
        author's request). The two below it are filters — they add and remove
        things from the map. This one moves the camera and shades the ground,
        over whatever those two have left on it.

        A SEGMENTED PILL, not two chips, and that is the whole reason it looks
        different from everything else in this panel. The chips either side of
        it are independent toggles, and a row of five outlines with two filled
        says "any of these, in any combination". These two are an either/or: one
        control with two positions, which is what a pill draws. Same grammar as
        the tab row above the frame, at panel scale.

        `role="radiogroup"` for the same reason the route picker has one —
        exactly one of them is true at a time — and it is `combined`-only, so
        the group is hidden by CSS outside that tab exactly as the Show row is.
      */}
      <div class="panel__group panel__group--combined">
        <span class="panel__legend" id="mapglobe-view-label">View</span>
        <div class="panel__seg" role="radiogroup" aria-labelledby="mapglobe-view-label">
          {MAP_VIEWS.map((item) => (
            <button
              type="button"
              class="panel__seg-opt"
              role="radio"
              aria-checked={item === DEFAULT_VIEW}
              title={VIEW_COPY[item].hint}
              data-mapglobe-view={item}
            >
              {VIEW_COPY[item].name}
            </button>
          ))}
        </div>
      </div>
      <div class="panel__group panel__group--combined">
        <span class="panel__legend" id="mapglobe-content-label">Show</span>
        <div class="panel__row" role="group" aria-labelledby="mapglobe-content-label">
          {MAP_CONTENT.map((item) => (
            <button
              type="button"
              class="panel__opt"
              aria-pressed={DEFAULT_CONTENT.includes(item)}
              title={CONTENT_COPY[item].hint}
              data-mapglobe-content={item}
            >
              {CONTENT_COPY[item].name}
            </button>
          ))}
        </div>
      </div>
      {/*
        The group is `display: contents`, so its label and its chips are direct
        children of the panel's grid rather than of the group. That is the whole
        reason it exists: labels land in the first column and chip rows in the
        second, so a row lines up with every other row rather than with itself.
        This panel has one group; the routes panel below has two, which is the
        case the structure was kept for — wrap each row in a real box instead
        and the second is pushed right by the width of its own label.
      */}
      <div class="panel__group">
        <span class="panel__legend" id="mapglobe-layers-label">Layers</span>
        <div class="panel__row" role="group" aria-labelledby="mapglobe-layers-label">
          {MAP_LAYERS.map((layer) => (
            <button
              type="button"
              class="panel__opt"
              aria-pressed={DEFAULT_LAYERS.includes(layer)}
              title={LAYER_COPY[layer].hint}
              data-mapglobe-hint={LAYER_COPY[layer].hint}
              data-mapglobe-layer={layer}
            >
              {LAYER_COPY[layer].name}
            </button>
          ))}
        </div>
      </div>
    </div>

    {/*
      The route picker, the same panel in the same corner for terrain mode.

      ONE radiogroup across all three rows, not one per row. Exactly one thing
      is on the map at a time — the overview or a single route — so separate
      groups would be a lie about what the controls do; the `Show`, `Hikes` and
      `Runs` legends are plain text inside it, and each chip's tooltip carries
      the place, the date and the distance a one-word chip cannot.

      Radio rather than the toggle chips next door, for the same reason: those
      five layers are independent and these eleven are one choice.

      It is no longer the only way into a route, and that is the point of the
      9 Sep 2026 change: the overview draws a card on every route, and clicking
      one does exactly what clicking a chip here does. This is the exhaustive
      list — every route, always reachable, including the two that sit on top of
      each other on the map because they start in the same car park.

      `aria-checked` ships on the overview chip and the script corrects all
      eleven from storage on load, exactly as the mode switcher does — a static
      build cannot know which route the visitor last looked at.
    */}
    {routes.length > 0 && (
      <div class="panel routes" role="radiogroup" aria-label="Recorded route" data-mapglobe-reserve>
        {/*
          The way back out, and the state the mode opens in. It belongs in this
          group rather than beside it: "show me all of them" is one of the
          answers to "which route", not a different question, and a radiogroup
          where nothing is checked would be a worse description of a map that is
          showing something.

          It ships checked because the overview is the default now — the route
          chips below ship unchecked for the same reason, and the script
          corrects all eleven from storage on load.
        */}
        <div class="panel__group">
          <span class="panel__legend">Show</span>
          <div class="panel__row">
            <button
              type="button"
              class="panel__opt"
              role="radio"
              aria-checked="true"
              title="Every route at once, grouped by the place it was walked."
              data-mapglobe-overview
            >
              All routes
            </button>
          </div>
        </div>
        {KINDS.map(
          (kind) =>
            routes.some((route) => route.kind === kind.id) && (
              <div class="panel__group">
                <span class="panel__legend">{kind.name}</span>
                <div class="panel__row">
                  {routes
                    .filter((route) => route.kind === kind.id)
                    .map((route) => (
                      <button
                        type="button"
                        class="panel__opt"
                        role="radio"
                        aria-checked="false"
                        title={routeHint(route)}
                        data-mapglobe-trail={route.id}
                      >
                        {route.label}
                      </button>
                    ))}
                </div>
              </div>
            ),
        )}
      </div>
    )}

    {/*
      THE INDEX RAIL, and it belongs to the `All` tab's three mesh views alone
      (10 Sep 2026, author's request).

      It answers a specific objection to Terrain 2: at the scale that puts a
      mountain range in frame, everything else the page has to show is off it,
      so changing subject meant zooming out to hunt for another card and zooming
      back in. That is the map being used as a menu. This is the menu.

      Down the RIGHT, where every other control on this map is bottom-left.
      Two panels on one edge would stack into a wall — and on a phone the lower
      of the two would be pushed off the frame — while a list this tall cannot
      share the bottom corner with a grid of chips anyway. It is also the shape
      the thing wants: an index reads as a column, and the column it reads as
      is the side of the frame.

      A DISCLOSURE, not a fixture. Nineteen rows is a third of a desktop frame
      and most of a phone one, and a reader who wants the mountain rather than
      the list has to be able to say so. It opens by default where there is
      room and starts shut below 640px; the choice is remembered under
      `mapglobe-index`. See index.ts.

      Real nested lists rather than a flat run of buttons, because the nesting
      is the content: three of these walks were taken on the Chengdu trip and
      one on the Phuket trip, and `walkedOn` derives that from the dates. A
      screen reader gets "Chengdu, list of 3 items" instead of eleven siblings.

      The route rows carry `data-mapglobe-trail` — the same attribute the picker
      chips and the map's own cards carry, so the page's one delegated handler
      serves all three and they cannot drift apart. The trip rows carry
      `data-mapglobe-place`, which nothing else does: framing a place is what
      this rail added.
    */}
    {indexGroups.length > 0 && (
      <div class="index" data-mapglobe-index data-mapglobe-reserve>
        <button
          type="button"
          class="index__toggle"
          aria-expanded="true"
          aria-controls="mapglobe-index-list"
          title="Every trip and every route, so changing subject never means zooming out."
          data-mapglobe-index-toggle
        >
          <span>Index</span>
          <span class="index__mark" aria-hidden="true">&#9662;</span>
        </button>
        <ul class="index__list" id="mapglobe-index-list">
          {indexGroups.map((group) => (
            <li class="index__group">
              {group.trip ? (
                <button
                  type="button"
                  class="index__row index__row--place"
                  title={`${group.name} — the ground it sits on${
                    group.routes.length
                      ? `, with the ${group.routes.length} walk${group.routes.length > 1 ? 's' : ''} taken there`
                      : ''
                  }.`}
                  data-mapglobe-place={group.trip.id}
                >
                  <span class="index__name">{group.name}</span>
                  <span class="index__meta">{placeMeta(group)}</span>
                </button>
              ) : (
                <p class="index__legend">{group.name}</p>
              )}
              {group.routes.length > 0 && (
                <ul class="index__nest">
                  {group.routes.map((route) => (
                    <li>
                      <button
                        type="button"
                        class="index__row index__row--route"
                        title={routeHint(route)}
                        data-mapglobe-trail={route.id}
                      >
                        <span class="index__name">{route.label}</span>
                        <span class="index__meta">{route.km.toFixed(1)} km</span>
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="mapglobe__status" data-mapglobe-status>Scroll down to load the map</p>
  </div>

  {/* Shown on the globe only, keyed off the same `data-mode` the script writes
      on the section. Text rather than swatches on purpose: the globe's colours
      are derived at runtime from the theme, so a swatch drawn in CSS would be a
      second guess at them and would be wrong the first time a step changed.

      The peaks-and-water sentence was a `.mapglobe__legend-extra` span, hidden
      outside explore because `atlas` could not draw either layer. With atlas
      gone that span had one side, so it is plain text again. It still names
      layers that may be switched off — as it always did in explore, since the
      legend describes what the chips can draw rather than what is drawn. */}
  <p class="mapglobe__legend">
    Dashed lines are country borders and the dots are cities &mdash; capitals slightly larger.
    &#9650; marks a named peak and its height, and rivers and lakes take the sea&rsquo;s colour.
    The places with a trip in them are the ones picked out in the page&rsquo;s accent on the map
    itself. The relief is real elevation at about 20&nbsp;km per pixel, lit from the north-west.
  </p>

  {/* Just the readout. A "Load a .gpx" label wrapping a file input and a Clear
      button sat beside it until 7 Sep 2026 — the first because ten routes are
      built in now and a visitor's own file answers nothing this page asks, the
      second because it was that file's undo, and with it gone Clear could only
      swap a route for an empty hillside. The route picker is the whole control
      surface for this mode. */}
  <div class="mapglobe__foot">
    <p class="mapglobe__readout" data-mapglobe-readout data-state="empty">No track loaded.</p>
  </div>

  <p class="mapglobe__note">
    Colours come from the same palette module the earth above uses, so both follow the theme
    picker. Nothing is fetched from a third party when <strong>Trips</strong> opens &mdash; the
    coastline, the footprints, the boundaries and every name are local files, and so are the
    peaks, rivers and lakes. The single exception is <strong>Relief</strong>, which reads
    elevation tiles from Mapterhorn; it is off until you switch it on, and it is the whole of <strong>Trails</strong>, the one mode that cannot preserve the property. The routes
    themselves are local, one small file each,
    fetched only for the route you pick. Nothing is requested until you ask for it &mdash; not the
    tiles, not the routes, and not any of the local layers either.
  </p>

  {/* The trips, handed to the script as data rather than fetched again. */}
  <script id="mapglobe-trips" type="application/json" set:html={JSON.stringify(trips)} is:inline />

  {/* And the routes, for the same reason. This is the figures the readout
      prints and the bounds the camera flies to — everything about a route
      except its geometry, which is the only part big enough to be worth a
      request. Under 4 KB for all ten, and it saves the script a round trip
      before it can draw the one terrain mode opens on. */}
  <script id="mapglobe-trails" type="application/json" set:html={JSON.stringify(routes)} is:inline />

  {/* And which routes were walked on which trip — four pairings, about 200
      bytes. The engine needs it to know what a trip's terrain view has to
      frame: Chengdu's three walks are 100 km from the city footprint, so
      fitting the footprint alone leaves the mountains off the frame. Passed as
      data rather than recomputed in the browser, because the dates it is
      derived from are in the content collection and never reach the client. */}
  <script
    id="mapglobe-walked-on"
    type="application/json"
    set:html={JSON.stringify(walkedOn)}
    is:inline
  />
</section>

<style>
  @reference "#styles";

  .mapglobe {
    @apply mt-20 border-t border-line pt-12;
  }

  .mapglobe__head {
    @apply mb-6 flex flex-col gap-3;
  }

  .mapglobe__eyebrow {
    @apply font-mono text-[0.7rem] tracking-[0.14em] text-fg-meta uppercase;
  }

  .mapglobe__title {
    @apply text-2xl font-semibold tracking-tight;
  }

  .mapglobe__intro {
    @apply max-w-2xl leading-relaxed text-fg-body;
  }

  .mapglobe__intro code {
    @apply rounded border border-line bg-surface-2 px-1 font-mono text-[0.8em] text-fg;
  }

  /* Inert without JS, and an inert control is worse than no control. Same
     `html.js` gate as GlobeStage, TripsViewToggle and ThemePicker. */
  .switch {
    @apply hidden;
  }

  :global(html.js) .switch {
    @apply mb-4 flex flex-wrap gap-0.5 rounded-full border border-line p-0.5;
  }

  .switch__opt {
    @apply rounded-full px-3 py-1.5 transition-colors;
    @apply font-mono text-[0.7rem] uppercase tracking-[0.1em] text-fg-meta;
    @apply hover:text-accent;
  }

  .switch__opt[aria-checked='true'] {
    @apply bg-surface-2 text-fg;
  }

  .switch__opt:focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  /* A panel floating over the map, in the corner of the frame. Inert without
     JS and shown in `explore` only, once the map is actually drawn — the same
     `html.js` gate as the switcher, plus `data-state` so it never sits on top
     of the "Drawing the map" message.

     `max-width` rather than a fixed width, so the same panel is a tidy block at
     1400px and a full-width strip at 390px without a second layout. */
  .panel {
    @apply hidden;
  }

  /* A two-column grid — labels in the first, chip rows in the second — so the
     rows align with each other rather than each aligning with itself.

     Two panels share this and only one is ever shown, because each is gated on
     the mode it belongs to. One grammar rather than two near-identical blocks:
     a chip is a chip, and the routes panel appearing in a different corner or a
     different size from the filters panel would read as a different kind of
     thing when it is the same kind of thing. */
  /* BOTTOM-left, not top-left (10 Sep 2026, author's request). The panel used
     to sit in the top corner, where it covered the part of the frame the camera
     is aimed at: every fit in this engine frames its subject near the middle
     and hangs each card ABOVE its anchor, so the top-left corner is where the
     labels go. Down here it overlaps the foreground instead — which under the
     pitched views is the near hillside, the one part of the frame with nothing
     on it that has to be read.

     Nothing else needed changing for the move, and that is worth knowing rather
     than luck: `framePadding` already branched on which half of the frame a
     reserved box sits in, and `declutter` reserves the panel by measuring its
     rect. Both follow the panel wherever it is put. */
  :global(html.js) [data-mode='explore'][data-state='ready'] .filters,
  :global(html.js) [data-mode='combined'][data-state='ready'] .filters,
  :global(html.js) [data-mode='terrain'][data-state='ready'] .routes {
    @apply absolute bottom-3 left-3 z-10 grid items-baseline gap-x-2.5 gap-y-1.5;
    @apply rounded-lg border border-line p-2.5;
    grid-template-columns: auto 1fr;
    max-width: min(32rem, calc(100% - 1.5rem));
    background: color-mix(in oklab, var(--color-bg) 84%, transparent);
    backdrop-filter: blur(6px);
  }

  /* Ten routes in two rows is taller than five filter chips in one, and the
     frame is 26rem on a phone. A cap plus a scroll keeps the panel from owning
     the map; `overscroll-behavior` stops a flick that runs off the end of the
     list from carrying on into the page. */
  :global(html.js) [data-mode='terrain'][data-state='ready'] .routes {
    max-height: calc(100% - 1.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* `contents`, so the label and the row below are laid out by the PANEL's grid
     rather than by this box. See the note in the markup. */
  .panel__group {
    display: contents;
  }

  /* `display: none` rather than a second panel, and it has to beat the
     `contents` above it — same specificity, so it comes after. `none` on a
     `contents` box removes the subtree, which `contents` alone cannot do.

     Named for the TAB, not for one of the groups it hides. It gated the Show
     row alone until the View switch joined it (10 Sep 2026), and both belong to
     `combined` for the same reason: `explore` draws only trips and only flat,
     so neither control has a second position there. */
  .panel__group--combined {
    display: none;
  }

  [data-mode='combined'] .panel__group--combined {
    display: contents;
  }

  .panel__row {
    @apply flex flex-wrap gap-1;
  }

  .panel__legend {
    @apply font-mono text-[0.58rem] tracking-[0.12em] text-fg-faint uppercase;
  }

  /* The view switch: one control with two positions, drawn as a pill, against
     the independent toggles either side of it drawn as separate outlines. The
     shape is the signal — see the note in the markup — and it is deliberately
     the same shape as the tab row above the frame, scaled to the panel.

     `fit-content` so the pill is as wide as its two words rather than
     stretching across the panel's second column, which would make it look like
     a row of chips that had merged.

     WRITTEN OUT RATHER THAN AS THE EQUIVALENT TAILWIND UTILITY, and there are
     two separate reasons, the second of which is a trap. First: `@apply` inside
     a scoped Astro block still emits the utility's definition into the SHARED
     stylesheet, on all 25 pages, even though the rule using it is page-scoped —
     so a utility nothing else on the site references costs every page. Second,
     and this is the part that wasted a measurement: Tailwind v4 scans source
     TEXT, so naming that utility in a comment is enough to emit it. The comment
     explaining the removal kept it alive. Do not write the class name here. */
  /* WRAPS BETWEEN OPTIONS, NEVER INSIDE ONE (10 Sep 2026, when Terrain 4 made
     it five). At 390px five labels do not fit on one line, and left to itself
     each one broke into "TERRAIN" over "4" — five two-line options, which is no
     shorter than two rows and much harder to read. Wrapping between them keeps
     every label intact; the shared outline is what still says it is one
     control. One line at every width from 640px up. */
  .panel__seg {
    @apply flex flex-wrap gap-0.5 rounded-full border border-line p-0.5;
    width: fit-content;
  }

  .panel__seg-opt {
    @apply cursor-pointer rounded-full px-2 py-0.5 whitespace-nowrap transition-colors;
    @apply font-mono text-[0.62rem] tracking-[0.08em] text-fg-faint uppercase;
    @apply hover:text-accent;
  }

  /* Filled, like a selected chip — the two controls disagree about their shape
     and must agree about what "on" looks like. */
  .panel__seg-opt[aria-checked='true'] {
    @apply bg-surface-2 text-fg;
  }

  .panel__seg-opt:focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  .panel__opt {
    @apply rounded-full border border-line px-2 py-0.5 transition-colors;
    @apply font-mono text-[0.62rem] tracking-[0.08em] text-fg-faint uppercase;
    @apply hover:text-accent;
  }

  /* Selected reads as filled, unselected as an outline. The two states have to
     be told apart at a glance across a row of chips, and a colour change alone
     is not enough when most of them are off. Both attributes, because the
     filters are toggles and the routes are one choice — see the markup. */
  .panel__opt[aria-pressed='true'],
  .panel__opt[aria-checked='true'] {
    @apply border-line-strong bg-surface-2 text-fg;
  }

  .panel__opt:focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  /* The Relief chip while the `All` tab's Terrain view is up. It reads as on,
     because the relief IS on, and it cannot be pressed, because the view owns
     it — see markLayers in index.ts for why disabling beats leaving a toggle
     that changes the stored set and nothing on the map.

     A dashed border rather than a fade: the chip has to keep reading as ON, and
     the usual way to show a disabled control is to lower its contrast, which
     here would make an active layer look inactive. Dashed says "not yours to
     press" without saying "off". `cursor: default` and no hover, so nothing
     about it invites the click. */
  .panel__opt:disabled {
    @apply border-dashed border-line-strong bg-surface-2 text-fg;
    cursor: default;
  }

  .panel__opt:disabled:hover {
    @apply text-fg;
  }

  /* ---- the index rail ---------------------------------------------------- *
     Same materials as the panels — the translucent `bg` wash, the hairline, the
     blur, the mono micro-caps — because it is the same kind of thing sitting on
     the same map. What differs is the shape, and the shape is the signal: the
     panels are grids of chips that change what is drawn, this is a column of
     proper nouns that changes where the camera is.

     Inert without JS and only once the map is drawn, the same two gates every
     control here is behind. `data-mesh-view` is written by index.ts and is true
     for exactly the three views that attach the terrain mesh — the ones where
     the frame holds one place and the rest of the collection is off it.

     `max-height` rather than `bottom: 0.75rem`: a rail stretched to the full
     height of the frame with eight rows in it is mostly empty, and it would
     reserve that emptiness from the camera fit as well. As tall as its content,
     up to the frame.
     ---------------------------------------------------------------------- */
  .index {
    @apply hidden;
  }

  :global(html.js) [data-mesh-view='true'][data-state='ready'] .index {
    @apply absolute top-3 right-3 z-10 flex flex-col;
    @apply rounded-lg border border-line p-1.5;
    width: 11.5rem;
    max-height: calc(100% - 1.5rem);
    background: color-mix(in oklab, var(--color-bg) 84%, transparent);
    backdrop-filter: blur(6px);
  }

  .index__toggle {
    @apply flex shrink-0 cursor-pointer items-center justify-between gap-2 rounded px-1.5 py-1;
    @apply font-mono text-[0.58rem] tracking-[0.12em] text-fg-meta uppercase;
    @apply hover:text-accent;
  }

  .index__toggle:focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  /* Points down at an open list and along at a shut one, which is the one
     convention a disclosure triangle has. */
  .index__mark {
    @apply text-[0.7rem] leading-none transition-transform;
  }

  .index__toggle[aria-expanded='false'] .index__mark {
    transform: rotate(-90deg);
  }

  /* The scroll lives on the LIST, not on the rail, so the toggle stays put
     while the rows move under it — a header that scrolls away is a header the
     reader cannot use to shut the thing. `overscroll-behavior` stops a flick
     that runs off the end from carrying on into the page, the same as the
     routes panel. */
  .index__list {
    @apply mt-0.5 flex flex-col gap-0.5 overflow-y-auto;
    overscroll-behavior: contain;
  }

  /* `display: flex` above beats the `hidden` attribute's UA `display: none`, so
     the collapsed rail would render open. This is the line that makes the
     toggle work at all, and it fails silently without it. */
  .index__list[hidden] {
    display: none;
  }

  .index__group,
  .index__nest li {
    @apply flex flex-col;
  }

  /* A rule down the left of the nested routes, which is what says they belong
     to the trip above rather than merely following it. Cheaper than an indent
     alone at this width: 11.5rem does not have many pixels to give away. */
  .index__nest {
    @apply ml-2 flex flex-col border-l border-line pl-1;
  }

  .index__row {
    @apply flex w-full cursor-pointer flex-col items-start rounded px-1.5 py-1 text-left;
    @apply transition-colors;
  }

  .index__row:hover {
    @apply bg-surface-2;
  }

  .index__row:focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  /* `fg-meta` and above throughout, never `fg-faint` — it is 2.31:1 on a chip
     in Classic, a known fault in the original palette, and it is already
     straining on the routes panel's ten proper nouns. Nineteen rows of them is
     where it would stop being legible. */
  .index__name {
    @apply text-[0.68rem] leading-tight font-medium text-fg-body;
  }

  .index__meta {
    @apply font-mono text-[0.55rem] tracking-[0.06em] text-fg-meta uppercase;
  }

  /* A trip outranks the walks nested under it by weight and one colour step —
     the same relationship the trip cards and the route cards have on the map
     itself, for the same reason: the trip is what the page is about and the
     route is a detail of it. */
  .index__row--place .index__name {
    @apply text-[0.72rem] font-semibold text-fg;
  }

  /* The one group that is not a trip. A label rather than a button, because
     there is no place to fly to: it is the six routes that fall inside no trip
     at all, and each of them is its own row. */
  .index__legend {
    @apply px-1.5 py-1 font-mono text-[0.58rem] tracking-[0.12em] text-fg-meta uppercase;
  }

  /* `aria-current`, NOT `aria-checked`. These are not options in the route
     picker's radiogroup — see markTrails in index.ts, which is scoped to
     `[role='radio']` for exactly this reason — they are places in an index, and
     the one the camera is on is the current one. */
  .index__row[aria-current='true'] {
    @apply bg-surface-2;
  }

  .index__row[aria-current='true'] .index__name {
    @apply text-accent;
  }

  /* The frame is short on a phone, so the panel gives back everything it can:
     tighter padding, smaller type, and the label column collapses — 45px of
     fixed width is worth more as a chip than as the word "Layers" when the
     whole frame is 390px wide. Labels then sit above their own rows, which is
     still aligned, just vertically. */
  @media (max-width: 639px) {
    :global(html.js) [data-mode='explore'][data-state='ready'] .filters,
    :global(html.js) [data-mode='combined'][data-state='ready'] .filters,
    :global(html.js) [data-mode='terrain'][data-state='ready'] .routes {
      @apply bottom-2 left-2 gap-x-0 gap-y-1 p-2;
      grid-template-columns: 1fr;
      max-width: calc(100% - 1rem);
    }

    :global(html.js) [data-mode='terrain'][data-state='ready'] .routes {
      max-height: calc(100% - 1rem);
    }

    /* Narrower and shorter, and it starts SHUT here — see storedIndex in
       index.ts. Half the height rather than all of it, so the rail and the
       filters panel below it are never the whole frame between them. */
    :global(html.js) [data-mesh-view='true'][data-state='ready'] .index {
      @apply top-2 right-2 p-1;
      width: 9.5rem;
      max-height: 50%;
    }

    .index__name {
      @apply text-[0.64rem];
    }

    .panel__legend {
      grid-column: 1;
    }

    .panel__opt {
      @apply px-1.5 text-[0.58rem] tracking-[0.04em];
    }
  }

  /* Matches GlobeStage exactly — same breakout, same heights. The two frames
     have to be the same size or the comparison is about scale rather than look.

     left/transform rather than `margin-inline: calc(50% - 50vw)`: 100vw
     includes the scrollbar, so the usual full-bleed trick overflows by its
     width and puts a horizontal scrollbar on the page. */
  .mapglobe__frame {
    @apply relative overflow-hidden rounded-xl border border-line bg-band;
    height: min(64vh, 26rem);
  }

  @media (min-width: 640px) {
    .mapglobe__frame {
      position: relative;
      left: 50%;
      width: min(96vw, 74rem);
      transform: translateX(-50%);
      height: min(88vh, 56rem);
    }
  }

  .mapglobe__stage {
    @apply absolute inset-0 opacity-0 transition-opacity duration-500;
  }

  [data-state='ready'] .mapglobe__stage {
    @apply opacity-100;
  }

  .mapglobe__labels {
    @apply pointer-events-none absolute inset-0;
  }

  /* Built by engine.ts as MapLibre markers rather than rendered here, so the
     selectors have to be global — Astro's scoping only reaches markup in this
     file. Styled to match GlobeStage's labels so the two earths read as the
     same page rather than two widgets. */
  .mapglobe__frame :global(.mapglobe__label) {
    @apply flex flex-col rounded border border-line-strong px-2 py-1 leading-tight whitespace-nowrap no-underline;
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(4px);
  }

  /* The same card as a control. Trip cards are links; the trails overview
     builds its route and area cards as <button>, and two of Tailwind v4's
     preflight defaults have to be undone for them: a button centres its text,
     and in v4 it no longer takes `cursor: pointer` on its own. */
  .mapglobe__frame :global(button.mapglobe__label) {
    @apply cursor-pointer text-left;
  }

  .mapglobe__frame :global(.mapglobe__label:hover) {
    @apply border-accent;
  }

  /* These are the only labels on the map that can be tabbed to — a hidden one
     is `visibility: hidden`, which takes it out of the tab order with it, so
     the ring can never appear on a card the reader cannot see. */
  .mapglobe__frame :global(.mapglobe__label:focus-visible) {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  .mapglobe__frame :global(.mapglobe__label-name) {
    @apply text-xs font-semibold text-fg;
  }

  .mapglobe__frame :global(.mapglobe__label:hover .mapglobe__label-name) {
    @apply text-accent;
  }

  .mapglobe__frame :global(.mapglobe__label-when) {
    @apply font-mono text-[0.6rem] uppercase tracking-[0.1em] text-fg-meta;
  }

  /* Atlas labels, also built by engine.ts, so also global.

     A halo rather than a chip. The eight trip labels are cards because they are
     links and there are eight of them; sixty boxed cards is a pin board, and a
     name with a halo behind it is what a map does instead.

     THE HALO IS `--color-bg`, NOT `--color-band`, and that is the whole reason
     it works in both directions (3 Sep 2026). The frame is painted in `band`,
     which is the ground palette.ts steps every one of the globe's own colours
     off — the sea is 10% of the way from it toward `fg` and the land 20% — so a
     band-coloured halo is a tenth of the ramp away from whatever is behind the
     text and barely separates from it. `bg` is on the far side of the ground
     from `fg` in every theme by construction, light and dark alike, so it is
     always the furthest thing from the map under it: measured against the land
     colour it is 1.77:1 in Classic and in dark, against band's 1.61:1, and
     against the TEXT it is a full step better in all nine themes.

     Four cardinal offsets at zero blur draw a crisp ring; the two blurred
     copies fill the diagonals and soften the edge. Repeating a shadow is what
     multiplies its opacity — a single one is transparent enough to read the
     coastline through.

     `block` is load-bearing: MapLibre positions a marker with `transform`, and
     transforms do not apply to a non-replaced inline element, so a bare span
     would sit in the corner. `pointer-events: none` is too — a marker element
     swallows the drag that started on it, and these are not links.

     The base is every atlas name; a rank below overrides only what it changes,
     and only the peak changes a colour.

     TWO CONTRASTS ACROSS THREE RANKS, one weight (3 Sep 2026, author's
     spec). This rule is the base, and it is BOTH the city and the country:
     they share `fg-meta` and are told apart by their setting alone. Only the
     peak overrides it. Weight stays 400 everywhere; the trip cards carry 600.

     Stated in dark mode, because that is where the author reads it and because
     "darker" and "lighter" swap meaning between the two themes — the semantic
     tokens swap with them, so one order covers both:

       peak            fg-body   #c3c3c9   the one rank that steps up
       country, city   fg-meta   #94949e   the map they sit on

     Light mode mirrors it exactly — peak `#374151`, the other two `#6b7280` —
     because that is what the token layer is for. Do NOT re-specify this per
     theme.

     Country and city sharing a colour is the point rather than a shortcut. The
     setting already separates them and has since the atlas shipped — letterspaced
     mono caps against mixed-case sans — so a second signal saying the same thing
     bought a step of contrast that had to come from somewhere, and the place it
     came from was the trip cards' share of the reader's attention. What is left
     is one quiet ground of names with the peaks lifted out of it, and the eight
     accent footprints above both.

     `fg-meta` is safe HERE for a reason that does not generalise: these labels
     carry a six-deep halo in `--color-bg`, and at a 10px glyph the 1px ring
     covers a letter's whole immediate surround. So the contrast that decides
     legibility is text-against-halo, not text-against-land — 4.83:1 Classic,
     5.22–5.59 across the other light themes, 6.46 dark. NOTHING WITHOUT THIS
     HALO may use it: against bare land the same colour is 2.74:1 in Classic.
     `fg-faint` stays off the table entirely — 2.54:1 against the halo there,
     under the 3:1 floor a UI mark needs — which is why extra steps have always
     had to come off the top of this ladder rather than the bottom.

     0.64rem, up from the 0.6rem this shipped with. Kept deliberately at the
     author's call when the size was put to them separately: small type over
     shaded relief needs it, and the cost is colliding a little sooner in the
     declutter pass. */
  .mapglobe__frame :global(.mapglobe__place) {
    --halo: var(--color-bg);
    @apply pointer-events-none block whitespace-nowrap;
    @apply font-sans text-[0.64rem] font-normal text-fg-meta;
    text-shadow:
      1px 0 0 var(--halo),
      -1px 0 0 var(--halo),
      0 1px 0 var(--halo),
      0 -1px 0 var(--halo),
      0 0 3px var(--halo),
      0 0 6px var(--halo);
  }

  /* Countries in letterspaced mono caps against everything else's mixed-case
     sans. Telling ranks of name apart by their setting rather than by a legend
     is the oldest convention on any map.

     It declares no colour and no weight, which is the whole of its current
     rank: it is a city label in a different setting. It ran at `fg-body` for
     several rounds and at `fg` AND weight 500 for one, and that round is the
     mistake to remember — a country name is context, it exists so the earth is
     not blank, and there are three times as many of them on screen as there are
     cities, spread in wide caps across every landmass. "Two ranks must stay a
     step apart" is true, and it does not follow that the step should be taken by
     raising the BACKGROUND rank. Here it is not taken at all. */
  .mapglobe__frame :global(.mapglobe__place--country) {
    @apply font-mono text-[0.62rem] tracking-[0.1em] uppercase;
  }

  /* The only atlas rank that steps off the base — brightest in dark, darkest
     in light.

     It has been three things: `fg-meta` as shipped, then `fg`, then the
     `color-mix` step between `fg` and `fg-body`. Both of the last two were
     reaching for separation from the trip cards, and `fg-body` gets it more
     cheaply than either — the card is 12px at weight 600 inside a bordered box
     in `fg`, and this is 10.2px at 400 with nothing around it, a full token
     below. The mix bought a rung that no longer had anything to sit between
     once the country came down to `fg-meta`.

     Measured on land: 4.74–6.25:1 across all nine themes, comfortably clear of
     AA at this size, and 7.83–11.07 against the halo.

     The ▲ and the height inherit it and declare no colour of their own, so a
     peak label reads as one object rather than a name with two accessories. */
  .mapglobe__frame :global(.mapglobe__place--peak) {
    @apply text-fg-body;
  }

  /* The ▲ that stands in for an icon layer — see `placeElement` in engine.ts.
     Subordinate by SIZE and nothing else: it briefly ran at `fg-faint`, which is
     2.7:1 on the land colour in Classic and under the 3:1 floor a UI mark needs.
     Ranking a glyph by fading it only works while the fade is still legible, and
     there is no room left below `fg-meta` to fade into. */
  .mapglobe__frame :global(.mapglobe__place-mark) {
    @apply mr-0.5 align-middle text-[0.72em];
  }

  /* A peak's height. Mono so a column of them lines up, and inheriting the
     name's colour — the setting and the size already tell them apart. The margin
     is small because there is a real space in the markup too. */
  .mapglobe__frame :global(.mapglobe__place-sub) {
    @apply ml-px font-mono text-[0.85em];
  }

  /* MapLibre ships its own control chrome. The attribution is a licence
     requirement and stays, but it is toned to the page rather than left in the
     library's blue-on-white. */
  .mapglobe__frame :global(.maplibregl-ctrl-attrib) {
    @apply rounded-tl border-t border-l border-line font-mono text-[0.6rem];
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    color: var(--color-fg-meta);
  }

  .mapglobe__frame :global(.maplibregl-ctrl-attrib a) {
    color: var(--color-fg-meta);
  }

  .mapglobe__frame :global(.maplibregl-ctrl-attrib-button) {
    background-color: transparent;
  }

  .mapglobe__status {
    @apply absolute inset-0 flex items-center justify-center px-6 text-center;
    @apply font-mono text-xs tracking-[0.12em] text-fg-faint uppercase;
  }

  .mapglobe__status[data-state='ready'] {
    @apply hidden;
  }

  /* A failure message is a sentence, not a label. */
  .mapglobe__status[data-state='failed'] {
    @apply tracking-normal normal-case;
  }

  /* One child since the actions row went (7 Sep 2026), so the flex row that
     used to hold the readout at one end and the buttons at the other is now
     just a margin. Kept as its own rule rather than folded into the readout:
     the readout is styled as text, this is where the block sits. */
  /* The readout is Trails' own line — it names the route on the map, or what the
     collection adds up to — so it is hidden in the two globe tabs rather than
     sitting under them saying "No track loaded" about a map with no track in
     it. Hidden without JS too, for the same reason the legend is: nothing can
     ever write to it then. Errors are still seen, because every path that
     writes one has already switched the mode to `terrain`. */
  .mapglobe__foot {
    @apply hidden;
  }

  [data-mode='terrain'] .mapglobe__foot {
    @apply mt-3 block;
  }

  /* Matches the frame's breakout so the readout and the buttons sit at its
     edges rather than floating in the middle of it. */
  @media (min-width: 640px) {
    .mapglobe__foot,
    .mapglobe__legend,
    .mapglobe__note {
      position: relative;
      left: 50%;
      width: min(96vw, 74rem);
      transform: translateX(-50%);
    }
  }

  .mapglobe__readout {
    @apply font-mono text-xs text-fg-meta;
  }

  .mapglobe__readout strong {
    @apply font-semibold text-fg;
  }

  .mapglobe__readout[data-state='error'] {
    @apply text-accent;
  }

  /* Hidden until the script writes `data-mode`, which means hidden without JS —
     consistent with the switcher that would be the only way to reach the mode
     it describes. */
  .mapglobe__legend {
    @apply hidden;
  }

  [data-mode='explore'] .mapglobe__legend,
  [data-mode='combined'] .mapglobe__legend {
    @apply mt-3 block max-w-2xl text-sm text-fg-meta;
  }

  .mapglobe__note {
    @apply mt-3 max-w-2xl text-sm text-fg-meta;
  }

  .mapglobe__note strong {
    @apply font-medium text-fg-body;
  }
</style>
