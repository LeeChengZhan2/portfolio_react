---
import type { CollectionEntry } from 'astro:content';
import { formatYears } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
---

{/* One row on /work. Extracted so the "Currently building" and "Previously"
    groups render identical markup — two copies of this would eventually drift.
    Heading level is h3: the page h1 is the title, each group heading is an h2. */}
<a href={`/work/${entry.id}`} class="row">
  <div class="row__main">
    <h3 class="row__title">{entry.data.title}</h3>
    <p class="row__summary">{entry.data.summary}</p>
    {
      entry.data.stack.length > 0 && (
        <ul class="chips">
          {entry.data.stack.map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="row__meta">
    <span class="row__year">{formatYears(entry.data)}</span>
    <span class="row__company">{entry.data.company ?? entry.data.role}</span>
  </div>
</a>

<style>
  @reference "#styles";

  .row {
    @apply flex flex-col gap-4 border-t border-line py-8 transition-colors sm:flex-row sm:items-start sm:justify-between;
    @apply hover:border-accent/40;
  }

  .row__main {
    @apply flex flex-col gap-2;
  }

  .row__title {
    @apply text-xl font-semibold tracking-tight text-fg;
  }

  .row:hover .row__title {
    @apply text-accent;
  }

  .row__summary {
    @apply max-w-xl text-sm leading-relaxed text-fg-muted;
  }

  .row__meta {
    @apply flex flex-none flex-row items-baseline gap-3 sm:w-40 sm:flex-col sm:items-end sm:gap-1;
  }

  .row__year {
    @apply font-mono text-sm tabular-nums text-fg-meta;
  }

  /* Who the work was for, falling back to the job title for self-directed work.
     The title alone repeated down the page and said less than the company. */
  .row__company {
    @apply text-xs text-fg-meta;
  }

  .chips {
    @apply flex flex-wrap gap-1.5 pt-1;
  }

  .chip {
    @apply rounded bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] text-fg-muted;
  }
</style>
