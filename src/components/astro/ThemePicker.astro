---
import { LIGHT_THEMES, themeClass } from '../../lib/themes';

// Heroicons 24/outline, inlined — same convention as Header.astro.
const SWATCH =
  'M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z';

const CHEVRON = 'm19.5 8.25-7.5 7.5-7.5-7.5';
---

{/*
  The light-theme picker. A menu, not a link to a preview page: choosing here
  re-themes the site you are already on, which is the only way to judge a theme
  on the pages you actually read.

  Click-driven rather than `group-hover` like the other header dropdowns. These
  are controls, not navigation — a hover menu cannot be operated by touch, which
  is the exact bug already logged against the nav dropdowns in CLAUDE.md. Open
  state lives in a `data-open` attribute set by src/scripts/theme.ts.

  aria-checked below is "false" on every item at build time. A static site
  cannot know the visitor's stored theme, and theme.ts corrects all of them on
  load. Nothing is visible before then: the menu is closed, and it can only be
  opened by the same script that fixes the values.
*/}
<div class="picker" data-theme-picker>
  <button
    type="button"
    class="picker__button"
    data-theme-menu-button
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <svg class="picker__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d={SWATCH} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Theme</span>
    <svg class="picker__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d={CHEVRON} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="picker__menu" id="theme-menu" role="menu" aria-label="Light theme">
    <ul class="picker__row">
      {
        LIGHT_THEMES.map((theme) => (
          <li>
            <button
              type="button"
              class="picker__item"
              role="menuitemradio"
              aria-checked="false"
              title={theme.hint}
              data-theme-option
              data-theme={theme.id}
            >
              {/* The swatch carries the theme's own class, so these four
                  utilities resolve against that palette instead of the page's.
                  That is why no hex appears anywhere in this file. */}
              <span class:list={['sw', themeClass(theme.id)]} aria-hidden="true">
                <span class="sw__band" />
                <span class="sw__dot" />
                <span class="sw__bar" />
              </span>
              <span class="picker__name">{theme.name}</span>
            </button>
          </li>
        ))
      }
    </ul>

    {/* The only thing the row cannot do is show eight full pages at once. */}
    <a href="/theme-preview" class="picker__compare">See all eight side by side &rarr;</a>
  </div>
</div>

<style>
  @reference "#styles";

  /* Hidden without JS, like ThemeToggle: an inert control is worse than no
     control. `html.js` is set by BaseLayout's inline head script. */
  .picker {
    @apply hidden;
  }

  /* NOT `relative`, deliberately. With no positioned ancestor of its own, the
     menu below anchors to `.navbar` — which is sticky, so positioned — and can
     therefore be centred on the viewport rather than on this button. A 30rem
     menu hung off a button sitting near the left edge of a 390px screen would
     overflow; centred on the header it never can. */
  :global(html.js) .picker {
    @apply inline-block;
  }

  .picker__button {
    @apply inline-flex items-center gap-1.5 rounded-full border border-dashed border-line-strong px-3 py-1 text-xs font-semibold text-fg-meta transition-colors;
    @apply hover:border-accent hover:text-accent;
  }

  :global(html.js) .picker[data-open] .picker__button {
    @apply border-solid border-accent text-accent;
  }

  .picker__icon {
    @apply h-4 w-4;
  }

  .picker__chevron {
    @apply h-3 w-3 transition-transform duration-150;
  }

  .picker[data-open] .picker__chevron {
    @apply rotate-180;
  }

  .picker__menu {
    @apply invisible absolute top-full left-1/2 z-50 mt-2 -translate-x-1/2 translate-y-1 rounded-2xl bg-surface/95 p-3 opacity-0 shadow-xl ring-1 ring-line backdrop-blur-md transition-all duration-150;
    /* Never wider than the viewport it is centred on; the row scrolls inside
       instead. 2rem is the header's own padding, doubled. */
    @apply max-w-[calc(100vw-2rem)];
  }

  .picker[data-open] .picker__menu {
    @apply visible translate-y-0 opacity-100;
  }

  /* The horizontal layout the row exists for: every theme visible at once,
     side by side, so they can be compared rather than remembered. */
  .picker__row {
    @apply flex flex-row items-start gap-1 overflow-x-auto;
  }

  .picker__item {
    @apply flex w-[4.5rem] flex-none flex-col items-center gap-1.5 rounded-xl px-1 py-2 text-[0.7rem] font-semibold text-fg-muted transition-colors;
    @apply hover:bg-surface-2 hover:text-accent;
  }

  /* Driven by aria-checked rather than by a per-theme `html.theme-x` selector,
     so adding a theme never means editing this file. Safe because the menu is
     closed on first paint and only JS can open it — by which point theme.ts has
     already set these. */
  .picker__item[aria-checked='true'] {
    @apply bg-surface-2 text-accent;
  }

  .picker__name {
    @apply text-center leading-tight;
  }

  .picker__compare {
    @apply mt-2 block border-t border-line pt-2 text-center text-xs text-fg-meta transition-colors hover:text-accent;
  }

  /* ---- the swatch -------------------------------------------------------
     A miniature of the page: its background, the band that steps off it, an
     accent dot and a bar of ink. Every colour comes from the theme class on
     `.sw` itself, including its border. */

  .sw {
    @apply relative block h-9 w-14 overflow-hidden rounded-lg border border-line-strong bg-bg;
  }

  .picker__item[aria-checked='true'] .sw {
    @apply outline-2 outline-offset-2 outline-accent;
  }

  .sw__band {
    @apply absolute inset-x-0 bottom-0 block h-1/3 bg-band;
  }

  .sw__dot {
    @apply absolute top-1.5 left-1.5 block h-2.5 w-2.5 rounded-full bg-accent;
  }

  .sw__bar {
    @apply absolute top-2 right-1.5 block h-1 w-4 rounded-full bg-fg;
  }
</style>
